{
  "zfVersion": "1.0",
  "name": "Academic research",
  "description": "A literature-to-permanent research workflow. Capture a literature note and on creation it is mined for claims, matched to candidate sources, cross-checked for contradictions and scored for maturity; then synthesise a permanent note that lands already related, linked and scored. Offline, no AI.",
  "author": "ZettelFlow",
  "canvas": {
    "filename": "Academic research.canvas",
    "content": "{\"nodes\":[{\"id\":\"acad-lit\",\"type\":\"file\",\"file\":\"Literature note.md\",\"x\":-440,\"y\":-110,\"width\":350,\"height\":220},{\"id\":\"acad-perm\",\"type\":\"file\",\"file\":\"Permanent note.md\",\"x\":120,\"y\":-110,\"width\":350,\"height\":220}],\"edges\":[{\"id\":\"acad-e1\",\"fromNode\":\"acad-lit\",\"fromSide\":\"right\",\"toNode\":\"acad-perm\",\"toSide\":\"left\",\"label\":\"synthesise\"}]}"
  },
  "steps": [
    {
      "filename": "Literature note.md",
      "content": "---\nzettelFlowSettings:\n  root: true\n  label: Literature note\n  phase: PROCESS\n  actions:\n    - type: prompt\n      id: zf-acad-title\n      description: Title\n      hasUI: true\n      key: title\n      zone: context\n      label: Title\n      placeholder: Name this literature note...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-acad-source\n      description: Source\n      hasUI: true\n      key: source\n      zone: frontmatter\n      label: Source\n      placeholder: Book, article, paper, talk...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-acad-author\n      description: Author\n      hasUI: true\n      key: author\n      zone: frontmatter\n      label: Author\n      placeholder: Who created it?...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-acad-summary\n      description: Your summary\n      hasUI: true\n      key: summary\n      zone: context\n      label: Your summary\n      placeholder: Summarise it in your own words...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-acad-state\n      hasUI: false\n      key: state\n      zone: frontmatter\n      staticBehaviour: true\n      staticValue: literature\n  onCreation:\n    - type: extract-claims\n      id: zf-acad-extract\n      hasUI: false\n      key: claims\n      zone: frontmatter\n    - type: find-sources\n      id: zf-acad-sources\n      hasUI: false\n      key: candidateSources\n      zone: frontmatter\n      limit: 5\n    - type: attach-source\n      id: zf-acad-attach\n      hasUI: false\n      source: ''\n      zone: frontmatter\n    - type: find-contradiction\n      id: zf-acad-contradiction\n      hasUI: false\n      key: contradictions\n      zone: frontmatter\n    - type: calculate-maturity\n      id: zf-acad-maturity\n      hasUI: false\n      key: maturity\n      zone: frontmatter\n  targetFolder: Research/Literature\n  childrenHeader: ''\n  optional: false\n---\n\n# {{title}}\n\n**Source:** {{source}} — {{author}}\n\n{{summary}}\n\n## Claims\n\n## Candidate sources\n\n## Contradictions\n"
    },
    {
      "filename": "Permanent note.md",
      "content": "---\nzettelFlowSettings:\n  root: true\n  label: Permanent note\n  phase: DEVELOP\n  actions:\n    - type: prompt\n      id: zf-acad-perm-title\n      description: Title\n      hasUI: true\n      key: title\n      zone: context\n      label: Title\n      placeholder: Name the idea...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-acad-perm-idea\n      description: The atomic idea\n      hasUI: true\n      key: idea\n      zone: context\n      label: The atomic idea\n      placeholder: State one idea, in your own words...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-acad-perm-connect\n      description: How does this connect to what you already know?\n      hasUI: true\n      key: connect\n      zone: context\n      label: How does this connect to what you already know?\n      placeholder: Link it to existing notes...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-acad-perm-state\n      hasUI: false\n      key: state\n      zone: frontmatter\n      staticBehaviour: true\n      staticValue: permanent\n  onCreation:\n    - type: find-related\n      id: zf-acad-perm-related\n      hasUI: false\n      key: related\n      zone: frontmatter\n      limit: 10\n    - type: suggest-link\n      id: zf-acad-perm-suggest\n      hasUI: false\n      key: suggestedLinks\n      zone: frontmatter\n      limit: 5\n    - type: calculate-maturity\n      id: zf-acad-perm-maturity\n      hasUI: false\n      key: maturity\n      zone: frontmatter\n  targetFolder: Research/Permanent\n  childrenHeader: ''\n  optional: false\n---\n\n# {{title}}\n\n{{idea}}\n\n## Connections\n\n{{connect}}\n\n## Related\n\n{{related}}\n\n## Suggested connections\n\n{{suggestedLinks}}\n"
    }
  ]
}
