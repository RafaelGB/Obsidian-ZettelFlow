{
  "zfVersion": "1.0",
  "name": "GTD",
  "description": "Getting Things Done as a note-creation system: three independent entry points on one canvas — Inbox capture, Next action, Project — moving a thought from capture through clarify to a context-tagged next action, each connected to your graph with find-related on creation. Offline, no AI.",
  "author": "ZettelFlow",
  "difficulty": "medium",
  "canvas": {
    "filename": "GTD.canvas",
    "content": "{\"nodes\":[{\"id\":\"gtd-0\",\"type\":\"file\",\"file\":\"Inbox capture.md\",\"x\":-540,\"y\":-110,\"width\":350,\"height\":220},{\"id\":\"gtd-1\",\"type\":\"file\",\"file\":\"Next action.md\",\"x\":-180,\"y\":-110,\"width\":350,\"height\":220},{\"id\":\"gtd-2\",\"type\":\"file\",\"file\":\"Project.md\",\"x\":180,\"y\":-110,\"width\":350,\"height\":220}],\"edges\":[]}"
  },
  "steps": [
    {
      "filename": "Inbox capture.md",
      "content": "---\nzettelFlowSettings:\n  root: true\n  label: Inbox capture\n  phase: CAPTURE\n  actions:\n    - type: prompt\n      id: zf-gtd-inbox-title\n      description: What landed in your head?\n      hasUI: true\n      key: title\n      zone: context\n      label: What landed in your head?\n      placeholder: Capture it, clarify later...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-gtd-inbox-tag\n      hasUI: false\n      key: gtd\n      zone: frontmatter\n      staticBehaviour: true\n      staticValue: inbox\n  targetFolder: GTD/Inbox\n  childrenHeader: ''\n  optional: false\n---\n\n# {{title}}\n"
    },
    {
      "filename": "Next action.md",
      "content": "---\nzettelFlowSettings:\n  root: true\n  label: Next action\n  phase: PROCESS\n  actions:\n    - type: prompt\n      id: zf-gtd-next-title\n      description: The very next physical action\n      hasUI: true\n      key: title\n      zone: context\n      label: The very next physical action\n      placeholder: 'Start with a verb: call, draft, buy...'\n      staticBehaviour: false\n    - type: prompt\n      id: zf-gtd-next-context\n      description: Context\n      hasUI: true\n      key: gtdContext\n      zone: frontmatter\n      label: Context\n      placeholder: '@home, @work, @errands, @calls...'\n      staticBehaviour: false\n    - type: prompt\n      id: zf-gtd-next-project\n      description: Related project\n      hasUI: true\n      key: project\n      zone: frontmatter\n      label: Related project\n      placeholder: Which project does this move forward?...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-gtd-next-tag\n      hasUI: false\n      key: gtd\n      zone: frontmatter\n      staticBehaviour: true\n      staticValue: next-action\n  onCreation:\n    - type: find-related\n      id: zf-gtd-next-related\n      hasUI: false\n      key: related\n      zone: frontmatter\n      limit: 10\n  targetFolder: GTD/Next actions\n  childrenHeader: ''\n  optional: false\n---\n\n# {{title}}\n\n- [ ] {{title}}\n\n**Context:** {{gtdContext}}\n**Project:** {{project}}\n\n## Related\n\n{{related}}\n"
    },
    {
      "filename": "Project.md",
      "content": "---\nzettelFlowSettings:\n  root: true\n  label: Project\n  phase: DEVELOP\n  actions:\n    - type: prompt\n      id: zf-gtd-proj-title\n      description: Project name\n      hasUI: true\n      key: title\n      zone: context\n      label: Project name\n      placeholder: A multi-step outcome...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-gtd-proj-outcome\n      description: Desired outcome\n      hasUI: true\n      key: outcome\n      zone: context\n      label: Desired outcome\n      placeholder: What does done look like?...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-gtd-proj-next\n      description: The very next action\n      hasUI: true\n      key: nextAction\n      zone: context\n      label: The very next action\n      placeholder: The single next physical step...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-gtd-proj-tag\n      hasUI: false\n      key: gtd\n      zone: frontmatter\n      staticBehaviour: true\n      staticValue: project\n  onCreation:\n    - type: find-related\n      id: zf-gtd-proj-related\n      hasUI: false\n      key: related\n      zone: frontmatter\n      limit: 10\n  targetFolder: GTD/Projects\n  childrenHeader: ''\n  optional: false\n---\n\n# {{title}}\n\n**Outcome:** {{outcome}}\n\n## Next actions\n\n- [ ] {{nextAction}}\n\n## Related\n\n{{related}}\n"
    }
  ]
}
