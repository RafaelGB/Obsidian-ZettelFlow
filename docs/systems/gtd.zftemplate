{
  "zfVersion": "1.0",
  "name": "GTD",
  "description": "Getting Things Done, drawn as a flow: one capture clarifies what a thought is and branches to a context-tagged next action, a project with an outcome, or a reference/someday note — each a phased step filed in its GTD folder and connected on creation. Offline, no AI.",
  "author": "ZettelFlow",
  "difficulty": "medium",
  "canvas": {
    "filename": "GTD.canvas",
    "content": "{\"nodes\":[{\"id\":\"gtd-capture\",\"type\":\"text\",\"x\":-560,\"y\":20,\"width\":340,\"height\":240,\"color\":\"1\",\"text\":\"Capture & clarify\",\"zettelflowConfig\":\"{\\\"root\\\":true,\\\"label\\\":\\\"Capture & clarify\\\",\\\"phase\\\":\\\"CAPTURE\\\",\\\"targetFolder\\\":\\\"GTD\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"gtd-title\\\",\\\"description\\\":\\\"What's on your mind?\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"title\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"What's on your mind?\\\",\\\"placeholder\\\":\\\"Name the thing...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"gtd-what\\\",\\\"description\\\":\\\"What is it?\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"what\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"What is it?\\\",\\\"placeholder\\\":\\\"Any context — why it's here...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"selector\\\",\\\"id\\\":\\\"gtd-disposition\\\",\\\"description\\\":\\\"What is it, really?\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"disposition\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"What is it, really?\\\",\\\"staticBehaviour\\\":false,\\\"defaultOption\\\":\\\"next\\\",\\\"options\\\":[[\\\"next\\\",\\\"A next action — one physical step I can do\\\"],[\\\"project\\\",\\\"A project — it needs more than one step\\\"],[\\\"reference\\\",\\\"Reference / someday — nothing to do now\\\"]]},{\\\"type\\\":\\\"tags\\\",\\\"id\\\":\\\"gtd-tags\\\",\\\"hasUI\\\":true,\\\"staticBehaviour\\\":false}],\\\"exits\\\":{\\\"gtd-to-next\\\":{\\\"says\\\":\\\"Next action\\\",\\\"when\\\":\\\"frontmatter.disposition === \\\\\\\"next\\\\\\\"\\\",\\\"order\\\":1,\\\"default\\\":true},\\\"gtd-to-project\\\":{\\\"says\\\":\\\"Project\\\",\\\"when\\\":\\\"frontmatter.disposition === \\\\\\\"project\\\\\\\"\\\",\\\"order\\\":2},\\\"gtd-to-reference\\\":{\\\"says\\\":\\\"Reference / someday\\\",\\\"when\\\":\\\"frontmatter.disposition === \\\\\\\"reference\\\\\\\"\\\",\\\"order\\\":3}},\\\"body\\\":\\\"\\\"}\"},{\"id\":\"gtd-next\",\"type\":\"text\",\"x\":-20,\"y\":-260,\"width\":340,\"height\":240,\"color\":\"3\",\"text\":\"Next action\",\"zettelflowConfig\":\"{\\\"root\\\":false,\\\"label\\\":\\\"Next action\\\",\\\"phase\\\":\\\"PROCESS\\\",\\\"targetFolder\\\":\\\"GTD/Next actions\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"gtd-next-action\\\",\\\"description\\\":\\\"The very next action\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"action\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"The very next action\\\",\\\"placeholder\\\":\\\"A single, physical, visible action...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"selector\\\",\\\"id\\\":\\\"gtd-next-context\\\",\\\"description\\\":\\\"Context\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"context\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"Context\\\",\\\"staticBehaviour\\\":false,\\\"defaultOption\\\":\\\"@anywhere\\\",\\\"options\\\":[[\\\"@home\\\",\\\"@home\\\"],[\\\"@work\\\",\\\"@work\\\"],[\\\"@computer\\\",\\\"@computer\\\"],[\\\"@calls\\\",\\\"@calls\\\"],[\\\"@errands\\\",\\\"@errands\\\"],[\\\"@anywhere\\\",\\\"@anywhere\\\"]]},{\\\"type\\\":\\\"calendar\\\",\\\"id\\\":\\\"gtd-next-due\\\",\\\"description\\\":\\\"Do it by (optional)\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"due\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"Do it by (optional)\\\",\\\"staticBehaviour\\\":false,\\\"enableTime\\\":false,\\\"format\\\":\\\"YYYY-MM-DD\\\"}],\\\"onCreation\\\":[{\\\"type\\\":\\\"find-related\\\",\\\"id\\\":\\\"gtd-next-related\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"related\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"limit\\\":10}],\\\"body\\\":\\\"# {{title}}\\\\n\\\\n{{what}}\\\\n\\\\n- [ ] {{action}}  ({{context}})\\\\n\\\\n**Do it by.** {{due}}\\\\n\\\\n## Related\\\\n\\\\n{{related}}\\\\n\\\"}\"},{\"id\":\"gtd-project\",\"type\":\"text\",\"x\":-20,\"y\":40,\"width\":340,\"height\":240,\"color\":\"5\",\"text\":\"Project\",\"zettelflowConfig\":\"{\\\"root\\\":false,\\\"label\\\":\\\"Project\\\",\\\"phase\\\":\\\"DEVELOP\\\",\\\"targetFolder\\\":\\\"GTD/Projects\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"gtd-proj-outcome\\\",\\\"description\\\":\\\"Desired outcome\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"outcome\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Desired outcome\\\",\\\"placeholder\\\":\\\"What does 'done' look like?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"gtd-proj-next\\\",\\\"description\\\":\\\"Next actions\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"nextActions\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Next actions\\\",\\\"placeholder\\\":\\\"The first physical steps...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"calendar\\\",\\\"id\\\":\\\"gtd-proj-review\\\",\\\"description\\\":\\\"Review on\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"review\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"Review on\\\",\\\"staticBehaviour\\\":false,\\\"enableTime\\\":false,\\\"format\\\":\\\"YYYY-MM-DD\\\"}],\\\"onCreation\\\":[{\\\"type\\\":\\\"find-related\\\",\\\"id\\\":\\\"gtd-proj-related\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"related\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"limit\\\":10},{\\\"type\\\":\\\"calculate-maturity\\\",\\\"id\\\":\\\"gtd-proj-maturity\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"maturity\\\",\\\"zone\\\":\\\"frontmatter\\\"}],\\\"body\\\":\\\"# {{title}}\\\\n\\\\n{{what}}\\\\n\\\\n**Outcome.** {{outcome}}\\\\n\\\\n**Review.** {{review}}\\\\n\\\\n## Next actions\\\\n\\\\n{{nextActions}}\\\\n\\\\n## Related\\\\n\\\\n{{related}}\\\\n\\\"}\"},{\"id\":\"gtd-reference\",\"type\":\"text\",\"x\":-20,\"y\":340,\"width\":340,\"height\":240,\"color\":\"4\",\"text\":\"Reference / someday\",\"zettelflowConfig\":\"{\\\"root\\\":false,\\\"label\\\":\\\"Reference / someday\\\",\\\"phase\\\":\\\"CONNECT\\\",\\\"targetFolder\\\":\\\"GTD/Reference\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"gtd-ref-topic\\\",\\\"description\\\":\\\"Topic\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"topic\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Topic\\\",\\\"placeholder\\\":\\\"What is this about?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"gtd-ref-note\\\",\\\"description\\\":\\\"The note\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"note\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"The note\\\",\\\"placeholder\\\":\\\"Anything worth keeping...\\\",\\\"staticBehaviour\\\":false}],\\\"onCreation\\\":[{\\\"type\\\":\\\"find-related\\\",\\\"id\\\":\\\"gtd-ref-related\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"related\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"limit\\\":10},{\\\"type\\\":\\\"detect-orphan\\\",\\\"id\\\":\\\"gtd-ref-orphan\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"orphan\\\",\\\"zone\\\":\\\"frontmatter\\\"}],\\\"body\\\":\\\"# {{title}}\\\\n\\\\n**Topic.** {{topic}}\\\\n\\\\n{{note}}\\\\n\\\\n## Related\\\\n\\\\n{{related}}\\\\n\\\"}\"}],\"edges\":[{\"id\":\"gtd-to-next\",\"fromNode\":\"gtd-capture\",\"toNode\":\"gtd-next\",\"fromSide\":\"right\",\"toSide\":\"left\",\"label\":\"Next action\"},{\"id\":\"gtd-to-project\",\"fromNode\":\"gtd-capture\",\"toNode\":\"gtd-project\",\"fromSide\":\"right\",\"toSide\":\"left\",\"label\":\"Project\"},{\"id\":\"gtd-to-reference\",\"fromNode\":\"gtd-capture\",\"toNode\":\"gtd-reference\",\"fromSide\":\"right\",\"toSide\":\"left\",\"label\":\"Reference / someday\"}]}"
  },
  "steps": []
}
