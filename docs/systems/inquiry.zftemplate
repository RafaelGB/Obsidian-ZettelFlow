{
  "zfVersion": "1.0",
  "name": "Inquiry",
  "description": "Start from a question, not an answer: capture what you want to know, why it matters and your current thinking; on creation ZettelFlow surfaces your other open questions, related notes and the claims you're implicitly making. Offline, no AI.",
  "author": "ZettelFlow",
  "canvas": {
    "filename": "Inquiry.canvas",
    "content": "{\"nodes\":[{\"id\":\"n-0\",\"type\":\"file\",\"file\":\"Inquiry.md\",\"x\":-600,\"y\":-120,\"width\":350,\"height\":240}],\"edges\":[]}"
  },
  "steps": [
    {
      "filename": "Inquiry.md",
      "content": "---\nzettelFlowSettings:\n  root: true\n  label: Open question\n  phase: PROCESS\n  actions:\n    - type: prompt\n      id: iq-title\n      description: Question\n      hasUI: true\n      key: title\n      zone: context\n      label: Question\n      placeholder: What do you want to understand?...\n      staticBehaviour: false\n    - type: prompt\n      id: iq-why\n      description: Why it matters\n      hasUI: true\n      key: why\n      zone: context\n      label: Why it matters\n      placeholder: Why is answering this valuable?...\n      staticBehaviour: false\n    - type: prompt\n      id: iq-thinking\n      description: Current thinking\n      hasUI: true\n      key: thinking\n      zone: context\n      label: Current thinking\n      placeholder: Where are you now?...\n      staticBehaviour: false\n    - type: prompt\n      id: iq-type\n      hasUI: false\n      key: type\n      zone: frontmatter\n      staticBehaviour: true\n      staticValue: inquiry\n    - type: prompt\n      id: iq-state\n      hasUI: false\n      key: state\n      zone: frontmatter\n      staticBehaviour: true\n      staticValue: fleeting\n  onCreation:\n    - type: find-unanswered-question\n      id: iq-unanswered\n      hasUI: false\n      key: unansweredQuestions\n      zone: frontmatter\n    - type: find-related\n      id: iq-related\n      hasUI: false\n      key: related\n      zone: frontmatter\n      limit: 8\n    - type: extract-claims\n      id: iq-claims\n      hasUI: false\n      key: claims\n      zone: frontmatter\n  targetFolder: Inquiries\n  childrenHeader: ''\n  optional: false\n---\n\n# {{title}}\n\n**Why it matters:** {{why}}\n\n## Current thinking\n\n{{thinking}}\n\n## Related open questions\n\n{{unansweredQuestions}}\n\n## Related notes\n\n{{related}}\n\n## Claims I'm making\n\n{{claims}}\n"
    }
  ]
}
