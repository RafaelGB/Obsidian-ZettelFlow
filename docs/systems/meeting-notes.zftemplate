{
  "zfVersion": "1.0",
  "name": "Meeting notes",
  "description": "Capture a meeting and file it into your graph: attendees, agenda, discussion and action items, tagged and stamped with a stable Zettel ID, then linked to related meetings and projects on creation. Offline, no AI.",
  "author": "ZettelFlow",
  "difficulty": "easy",
  "canvas": {
    "filename": "Meeting notes.canvas",
    "content": "{\"nodes\":[{\"id\":\"n-0\",\"type\":\"file\",\"file\":\"Meeting.md\",\"x\":-600,\"y\":-120,\"width\":350,\"height\":240}],\"edges\":[]}"
  },
  "steps": [
    {
      "filename": "Meeting.md",
      "content": "---\nzettelFlowSettings:\n  root: true\n  label: Meeting note\n  phase: CAPTURE\n  actions:\n    - type: prompt\n      id: mtg-title\n      description: Meeting title\n      hasUI: true\n      key: title\n      zone: context\n      label: Meeting title\n      placeholder: What was the meeting about?...\n      staticBehaviour: false\n    - type: prompt\n      id: mtg-attendees\n      description: Attendees\n      hasUI: true\n      key: attendees\n      zone: frontmatter\n      label: Attendees\n      placeholder: Who was there?...\n      staticBehaviour: false\n    - type: prompt\n      id: mtg-agenda\n      description: Agenda\n      hasUI: true\n      key: agenda\n      zone: context\n      label: Agenda\n      placeholder: What did you plan to cover?...\n      staticBehaviour: false\n    - type: prompt\n      id: mtg-notes\n      description: Discussion notes\n      hasUI: true\n      key: notes\n      zone: context\n      label: Discussion notes\n      placeholder: What was said?...\n      staticBehaviour: false\n    - type: prompt\n      id: mtg-actions\n      description: Action items\n      hasUI: true\n      key: actions\n      zone: context\n      label: Action items\n      placeholder: One per line, start with a verb...\n      staticBehaviour: false\n    - type: prompt\n      id: mtg-type\n      hasUI: false\n      key: type\n      zone: frontmatter\n      staticBehaviour: true\n      staticValue: meeting\n    - type: zettel-id\n      id: mtg-id\n      hasUI: false\n      strategy: timestamp\n      key: id\n      writeFrontmatter: true\n      writeFilename: false\n      timestampFormat: YYYYMMDDHHmm\n      relationship: child\n  onCreation:\n    - type: find-related\n      id: mtg-related\n      hasUI: false\n      key: related\n      zone: frontmatter\n      limit: 10\n  targetFolder: Meetings\n  childrenHeader: ''\n  optional: false\n---\n\n# {{title}}\n\n**Attendees:** {{attendees}}\n\n## Agenda\n\n{{agenda}}\n\n## Discussion\n\n{{notes}}\n\n## Action items\n\n- [ ] {{actions}}\n\n## Related\n\n{{related}}\n"
    }
  ]
}
