{
  "zfVersion": "1.0",
  "name": "PARA v2",
  "description": "Tiago Forte's PARA as a note-creation system: four independent entry points on one canvas — Project, Area, Resource, Archive — each landing a note in its PARA folder, tagged with its category and connected to your graph with find-related on creation. Repositions the original PARA classify flow. Offline, no AI.",
  "author": "ZettelFlow",
  "difficulty": "hard",
  "canvas": {
    "filename": "PARA v2.canvas",
    "content": "{\"nodes\":[{\"id\":\"para-0\",\"type\":\"file\",\"file\":\"Project.md\",\"x\":-600,\"y\":-110,\"width\":350,\"height\":220},{\"id\":\"para-1\",\"type\":\"file\",\"file\":\"Area.md\",\"x\":-280,\"y\":-110,\"width\":350,\"height\":220},{\"id\":\"para-2\",\"type\":\"file\",\"file\":\"Resource.md\",\"x\":40,\"y\":-110,\"width\":350,\"height\":220},{\"id\":\"para-3\",\"type\":\"file\",\"file\":\"Archive.md\",\"x\":360,\"y\":-110,\"width\":350,\"height\":220}],\"edges\":[]}"
  },
  "steps": [
    {
      "filename": "Project.md",
      "content": "---\nzettelFlowSettings:\n  root: true\n  label: Project\n  phase: CLASSIFY\n  actions:\n    - type: prompt\n      id: zf-para-project-title\n      description: Title\n      hasUI: true\n      key: title\n      zone: context\n      label: Title\n      placeholder: Name this project...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-para-project-desc\n      description: What is it?\n      hasUI: true\n      key: description\n      zone: context\n      label: What is it?\n      placeholder: A line or two of context...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-para-project-tag\n      hasUI: false\n      key: para\n      zone: frontmatter\n      staticBehaviour: true\n      staticValue: project\n  onCreation:\n    - type: find-related\n      id: zf-para-project-related\n      hasUI: false\n      key: related\n      zone: frontmatter\n      limit: 10\n    - type: calculate-maturity\n      id: zf-para-v2-0-calculate-maturity0\n      hasUI: false\n      key: maturity\n      zone: frontmatter\n    - type: detect-orphan\n      id: zf-para-v2-0-detect-orphan1\n      hasUI: false\n      key: orphan\n      zone: frontmatter\n    - type: suggest-next-move\n      id: zf-para-v2-0-suggest-next-move2\n      hasUI: false\n      key: nextMoves\n      zone: frontmatter\n    - type: extract-claims\n      id: zf-para-v2-0-extract-claims3\n      hasUI: false\n      key: claims\n      zone: frontmatter\n    - type: find-unanswered-question\n      id: zf-para-v2-0-find-unanswered-question4\n      hasUI: false\n      key: unanswered-questions\n      zone: frontmatter\n  targetFolder: PARA/1 Projects\n  childrenHeader: ''\n  optional: false\n---\n\n# {{title}}\n\n{{description}}\n\n## Related\n\n{{related}}\n"
    },
    {
      "filename": "Area.md",
      "content": "---\nzettelFlowSettings:\n  root: true\n  label: Area\n  phase: CLASSIFY\n  actions:\n    - type: prompt\n      id: zf-para-area-title\n      description: Title\n      hasUI: true\n      key: title\n      zone: context\n      label: Title\n      placeholder: Name this area...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-para-area-desc\n      description: What is it?\n      hasUI: true\n      key: description\n      zone: context\n      label: What is it?\n      placeholder: A line or two of context...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-para-area-tag\n      hasUI: false\n      key: para\n      zone: frontmatter\n      staticBehaviour: true\n      staticValue: area\n  onCreation:\n    - type: find-related\n      id: zf-para-area-related\n      hasUI: false\n      key: related\n      zone: frontmatter\n      limit: 10\n    - type: calculate-maturity\n      id: zf-para-v2-1-calculate-maturity0\n      hasUI: false\n      key: maturity\n      zone: frontmatter\n    - type: detect-orphan\n      id: zf-para-v2-1-detect-orphan1\n      hasUI: false\n      key: orphan\n      zone: frontmatter\n    - type: suggest-next-move\n      id: zf-para-v2-1-suggest-next-move2\n      hasUI: false\n      key: nextMoves\n      zone: frontmatter\n    - type: extract-claims\n      id: zf-para-v2-1-extract-claims3\n      hasUI: false\n      key: claims\n      zone: frontmatter\n    - type: find-unanswered-question\n      id: zf-para-v2-1-find-unanswered-question4\n      hasUI: false\n      key: unanswered-questions\n      zone: frontmatter\n  targetFolder: PARA/2 Areas\n  childrenHeader: ''\n  optional: false\n---\n\n# {{title}}\n\n{{description}}\n\n## Related\n\n{{related}}\n"
    },
    {
      "filename": "Resource.md",
      "content": "---\nzettelFlowSettings:\n  root: true\n  label: Resource\n  phase: CLASSIFY\n  actions:\n    - type: prompt\n      id: zf-para-resource-title\n      description: Title\n      hasUI: true\n      key: title\n      zone: context\n      label: Title\n      placeholder: Name this resource...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-para-resource-desc\n      description: What is it?\n      hasUI: true\n      key: description\n      zone: context\n      label: What is it?\n      placeholder: A line or two of context...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-para-resource-tag\n      hasUI: false\n      key: para\n      zone: frontmatter\n      staticBehaviour: true\n      staticValue: resource\n  onCreation:\n    - type: find-related\n      id: zf-para-resource-related\n      hasUI: false\n      key: related\n      zone: frontmatter\n      limit: 10\n    - type: calculate-maturity\n      id: zf-para-v2-2-calculate-maturity0\n      hasUI: false\n      key: maturity\n      zone: frontmatter\n    - type: detect-orphan\n      id: zf-para-v2-2-detect-orphan1\n      hasUI: false\n      key: orphan\n      zone: frontmatter\n    - type: suggest-next-move\n      id: zf-para-v2-2-suggest-next-move2\n      hasUI: false\n      key: nextMoves\n      zone: frontmatter\n    - type: extract-claims\n      id: zf-para-v2-2-extract-claims3\n      hasUI: false\n      key: claims\n      zone: frontmatter\n    - type: find-unanswered-question\n      id: zf-para-v2-2-find-unanswered-question4\n      hasUI: false\n      key: unanswered-questions\n      zone: frontmatter\n  targetFolder: PARA/3 Resources\n  childrenHeader: ''\n  optional: false\n---\n\n# {{title}}\n\n{{description}}\n\n## Related\n\n{{related}}\n"
    },
    {
      "filename": "Archive.md",
      "content": "---\nzettelFlowSettings:\n  root: true\n  label: Archive\n  phase: CLASSIFY\n  actions:\n    - type: prompt\n      id: zf-para-archive-title\n      description: Title\n      hasUI: true\n      key: title\n      zone: context\n      label: Title\n      placeholder: Name this archive...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-para-archive-desc\n      description: What is it?\n      hasUI: true\n      key: description\n      zone: context\n      label: What is it?\n      placeholder: A line or two of context...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-para-archive-tag\n      hasUI: false\n      key: para\n      zone: frontmatter\n      staticBehaviour: true\n      staticValue: archive\n  onCreation:\n    - type: find-related\n      id: zf-para-archive-related\n      hasUI: false\n      key: related\n      zone: frontmatter\n      limit: 10\n    - type: calculate-maturity\n      id: zf-para-v2-3-calculate-maturity0\n      hasUI: false\n      key: maturity\n      zone: frontmatter\n    - type: detect-orphan\n      id: zf-para-v2-3-detect-orphan1\n      hasUI: false\n      key: orphan\n      zone: frontmatter\n    - type: suggest-next-move\n      id: zf-para-v2-3-suggest-next-move2\n      hasUI: false\n      key: nextMoves\n      zone: frontmatter\n    - type: extract-claims\n      id: zf-para-v2-3-extract-claims3\n      hasUI: false\n      key: claims\n      zone: frontmatter\n    - type: find-unanswered-question\n      id: zf-para-v2-3-find-unanswered-question4\n      hasUI: false\n      key: unanswered-questions\n      zone: frontmatter\n  targetFolder: PARA/4 Archive\n  childrenHeader: ''\n  optional: false\n---\n\n# {{title}}\n\n{{description}}\n\n## Related\n\n{{related}}\n"
    }
  ]
}