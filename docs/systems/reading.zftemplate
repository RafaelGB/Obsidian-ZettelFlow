{
  "zfVersion": "1.0",
  "name": "Reading",
  "description": "Turn reading into knowledge: a Reading source entry point captures a book or article with its highlights and, on creation, mines them for claims and matches candidate sources; a Reading note entry point distills an insight and connects it to your graph. Two independent entry points, offline, no AI.",
  "author": "ZettelFlow",
  "canvas": {
    "filename": "Reading.canvas",
    "content": "{\"nodes\":[{\"id\":\"read-0\",\"type\":\"file\",\"file\":\"Reading source.md\",\"x\":-600,\"y\":-110,\"width\":350,\"height\":220},{\"id\":\"read-1\",\"type\":\"file\",\"file\":\"Reading note.md\",\"x\":-280,\"y\":-110,\"width\":350,\"height\":220}],\"edges\":[]}"
  },
  "steps": [
    {
      "filename": "Reading source.md",
      "content": "---\nzettelFlowSettings:\n  root: true\n  label: Reading source\n  phase: CAPTURE\n  actions:\n    - type: prompt\n      id: zf-read-src-title\n      description: Title\n      hasUI: true\n      key: title\n      zone: context\n      label: Title\n      placeholder: The book, article or talk...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-read-src-author\n      description: Author\n      hasUI: true\n      key: author\n      zone: frontmatter\n      label: Author\n      placeholder: Who created it?...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-read-src-type\n      description: Type\n      hasUI: true\n      key: sourceType\n      zone: frontmatter\n      label: Type\n      placeholder: book, article, video, paper...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-read-src-highlights\n      description: Highlights\n      hasUI: true\n      key: highlights\n      zone: context\n      label: Highlights\n      placeholder: Paste the passages that struck you...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-read-src-tag\n      hasUI: false\n      key: reading\n      zone: frontmatter\n      staticBehaviour: true\n      staticValue: source\n  onCreation:\n    - type: extract-claims\n      id: zf-read-src-claims\n      hasUI: false\n      key: claims\n      zone: frontmatter\n    - type: find-sources\n      id: zf-read-src-sources\n      hasUI: false\n      key: candidateSources\n      zone: frontmatter\n      limit: 5\n  targetFolder: Reading/Sources\n  childrenHeader: ''\n  optional: false\n---\n\n# {{title}}\n\n**Author:** {{author}} · **Type:** {{sourceType}}\n\n## Highlights\n\n{{highlights}}\n\n## Claims\n\n## Candidate sources\n"
    },
    {
      "filename": "Reading note.md",
      "content": "---\nzettelFlowSettings:\n  root: true\n  label: Reading note\n  phase: DEVELOP\n  actions:\n    - type: prompt\n      id: zf-read-note-title\n      description: Title\n      hasUI: true\n      key: title\n      zone: context\n      label: Title\n      placeholder: Name the insight...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-read-note-insight\n      description: The insight\n      hasUI: true\n      key: insight\n      zone: context\n      label: The insight\n      placeholder: In your own words, what did you take from it?...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-read-note-from\n      description: From source\n      hasUI: true\n      key: fromSource\n      zone: frontmatter\n      label: From source\n      placeholder: '[[the source you read]]...'\n      staticBehaviour: false\n    - type: prompt\n      id: zf-read-note-tag\n      hasUI: false\n      key: reading\n      zone: frontmatter\n      staticBehaviour: true\n      staticValue: note\n  onCreation:\n    - type: find-related\n      id: zf-read-note-related\n      hasUI: false\n      key: related\n      zone: frontmatter\n      limit: 10\n    - type: suggest-link\n      id: zf-read-note-suggest\n      hasUI: false\n      key: suggestedLinks\n      zone: frontmatter\n      limit: 5\n  targetFolder: Reading/Notes\n  childrenHeader: ''\n  optional: false\n---\n\n# {{title}}\n\n{{insight}}\n\n**From:** {{fromSource}}\n\n## Related\n\n{{related}}\n\n## Suggested connections\n\n{{suggestedLinks}}\n"
    }
  ]
}
