{
  "zfVersion": "1.0",
  "name": "Software architecture KB",
  "description": "A software architecture knowledge base, drawn as a flow: one capture asks whether you're recording a decision or a component, and branches to an ADR (context, decision, status, consequences, alternatives) or a component note (responsibility, interfaces, dependencies) — cross-checked on creation. Offline, no AI.",
  "author": "ZettelFlow",
  "difficulty": "hard",
  "canvas": {
    "filename": "Software architecture KB.canvas",
    "content": "{\"nodes\":[{\"id\":\"sa-capture\",\"type\":\"text\",\"x\":-560,\"y\":20,\"width\":340,\"height\":250,\"color\":\"1\",\"text\":\"Architecture KB\",\"zettelflowConfig\":\"{\\\"slug\\\":\\\"sa-capture\\\",\\\"root\\\":true,\\\"label\\\":\\\"Architecture KB\\\",\\\"phase\\\":\\\"CAPTURE\\\",\\\"color\\\":\\\"1\\\",\\\"targetFolder\\\":\\\"Architecture\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"sa-title\\\",\\\"description\\\":\\\"Title\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"title\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Title\\\",\\\"placeholder\\\":\\\"Name it...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"selector\\\",\\\"id\\\":\\\"sa-kind\\\",\\\"description\\\":\\\"What is it?\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"kind\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"What is it?\\\",\\\"staticBehaviour\\\":false,\\\"defaultOption\\\":\\\"decision\\\",\\\"options\\\":[[\\\"decision\\\",\\\"A decision (ADR)\\\"],[\\\"component\\\",\\\"A component\\\"]]},{\\\"type\\\":\\\"tags\\\",\\\"id\\\":\\\"sa-tags\\\",\\\"hasUI\\\":true,\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"zettel-id\\\",\\\"id\\\":\\\"sa-id\\\",\\\"hasUI\\\":false,\\\"strategy\\\":\\\"timestamp\\\",\\\"key\\\":\\\"id\\\",\\\"writeFrontmatter\\\":true,\\\"writeFilename\\\":false,\\\"timestampFormat\\\":\\\"YYYYMMDDHHmm\\\",\\\"relationship\\\":\\\"child\\\"}],\\\"exits\\\":{\\\"sa-e-adr\\\":{\\\"says\\\":\\\"A decision\\\",\\\"when\\\":\\\"frontmatter.kind === \\\\\\\"decision\\\\\\\"\\\",\\\"order\\\":1,\\\"default\\\":true},\\\"sa-e-comp\\\":{\\\"says\\\":\\\"A component\\\",\\\"when\\\":\\\"frontmatter.kind === \\\\\\\"component\\\\\\\"\\\",\\\"order\\\":2}},\\\"exitFor\\\":[\\\"sa-e-adr\\\",\\\"sa-e-comp\\\"],\\\"body\\\":\\\"\\\"}\"},{\"id\":\"sa-decision\",\"type\":\"text\",\"x\":-20,\"y\":-300,\"width\":340,\"height\":250,\"color\":\"5\",\"text\":\"Decision record\",\"zettelflowConfig\":\"{\\\"slug\\\":\\\"sa-decision\\\",\\\"root\\\":false,\\\"label\\\":\\\"Decision record\\\",\\\"phase\\\":\\\"DEVELOP\\\",\\\"color\\\":\\\"5\\\",\\\"targetFolder\\\":\\\"Architecture/Decisions\\\",\\\"says\\\":\\\"A decision\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"sa-adr-context\\\",\\\"description\\\":\\\"Context\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"context\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Context\\\",\\\"placeholder\\\":\\\"The forces at play...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"sa-adr-decision\\\",\\\"description\\\":\\\"Decision\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"decision\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Decision\\\",\\\"placeholder\\\":\\\"What we decided...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"selector\\\",\\\"id\\\":\\\"sa-adr-status\\\",\\\"description\\\":\\\"Status\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"status\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"Status\\\",\\\"staticBehaviour\\\":false,\\\"defaultOption\\\":\\\"proposed\\\",\\\"options\\\":[[\\\"proposed\\\",\\\"Proposed\\\"],[\\\"accepted\\\",\\\"Accepted\\\"],[\\\"superseded\\\",\\\"Superseded\\\"]]},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"sa-adr-consequences\\\",\\\"description\\\":\\\"Consequences\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"consequences\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Consequences\\\",\\\"placeholder\\\":\\\"What follows, good and bad...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"sa-adr-alternatives\\\",\\\"description\\\":\\\"Alternatives\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"alternatives\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Alternatives\\\",\\\"placeholder\\\":\\\"What we rejected, and why...\\\",\\\"staticBehaviour\\\":false}],\\\"onCreation\\\":[{\\\"type\\\":\\\"find-related\\\",\\\"id\\\":\\\"sa-adr-rel\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"related\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"limit\\\":10},{\\\"type\\\":\\\"find-contradiction\\\",\\\"id\\\":\\\"sa-adr-con\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"contradictions\\\",\\\"zone\\\":\\\"frontmatter\\\"},{\\\"type\\\":\\\"calculate-maturity\\\",\\\"id\\\":\\\"sa-adr-mat\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"maturity\\\",\\\"zone\\\":\\\"frontmatter\\\"}],\\\"body\\\":\\\"# {{title}}\\\\n\\\\n**Status.** {{status}}\\\\n\\\\n## Context\\\\n\\\\n{{context}}\\\\n\\\\n## Decision\\\\n\\\\n{{decision}}\\\\n\\\\n## Consequences\\\\n\\\\n{{consequences}}\\\\n\\\\n## Alternatives\\\\n\\\\n{{alternatives}}\\\\n\\\\n## Tensions\\\\n\\\\n{{contradictions}}\\\\n\\\\n## Related\\\\n\\\\n{{related}}\\\\n\\\"}\"},{\"id\":\"sa-component\",\"type\":\"text\",\"x\":-20,\"y\":0,\"width\":340,\"height\":250,\"color\":\"4\",\"text\":\"Component\",\"zettelflowConfig\":\"{\\\"slug\\\":\\\"sa-component\\\",\\\"root\\\":false,\\\"label\\\":\\\"Component\\\",\\\"phase\\\":\\\"CONNECT\\\",\\\"color\\\":\\\"4\\\",\\\"targetFolder\\\":\\\"Architecture/Components\\\",\\\"says\\\":\\\"A component\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"sa-comp-responsibility\\\",\\\"description\\\":\\\"Responsibility\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"responsibility\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Responsibility\\\",\\\"placeholder\\\":\\\"What it owns...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"sa-comp-interfaces\\\",\\\"description\\\":\\\"Interfaces\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"interfaces\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Interfaces\\\",\\\"placeholder\\\":\\\"What it exposes...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"sa-comp-dependencies\\\",\\\"description\\\":\\\"Dependencies\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"dependencies\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Dependencies\\\",\\\"placeholder\\\":\\\"What it needs...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"sa-comp-tech\\\",\\\"description\\\":\\\"Tech\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"tech\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Tech\\\",\\\"placeholder\\\":\\\"Language / framework...\\\",\\\"staticBehaviour\\\":false}],\\\"onCreation\\\":[{\\\"type\\\":\\\"find-related\\\",\\\"id\\\":\\\"sa-comp-rel\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"related\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"limit\\\":10},{\\\"type\\\":\\\"detect-orphan\\\",\\\"id\\\":\\\"sa-comp-orph\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"orphan\\\",\\\"zone\\\":\\\"frontmatter\\\"}],\\\"body\\\":\\\"# {{title}}\\\\n\\\\n**Responsibility.** {{responsibility}}\\\\n\\\\n**Tech.** {{tech}}\\\\n\\\\n## Interfaces\\\\n\\\\n{{interfaces}}\\\\n\\\\n## Dependencies\\\\n\\\\n{{dependencies}}\\\\n\\\\n## Related\\\\n\\\\n{{related}}\\\\n\\\"}\"}],\"edges\":[{\"id\":\"sa-e-adr\",\"fromNode\":\"sa-capture\",\"toNode\":\"sa-decision\",\"fromSide\":\"right\",\"toSide\":\"left\",\"label\":\"A decision\"},{\"id\":\"sa-e-comp\",\"fromNode\":\"sa-capture\",\"toNode\":\"sa-component\",\"fromSide\":\"right\",\"toSide\":\"left\",\"label\":\"A component\"}]}"
  },
