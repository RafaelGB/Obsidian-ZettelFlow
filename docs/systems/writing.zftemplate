{
  "zfVersion": "1.0",
  "name": "Writing",
  "description": "Take a piece from idea to finished draft: a Draft entry point sets the thesis and pulls in related source notes, a Section entry point develops one point and suggests connections, and a Review entry point surfaces contradictions to resolve. Three independent entry points, offline, no AI.",
  "author": "ZettelFlow",
  "difficulty": "medium",
  "canvas": {
    "filename": "Writing.canvas",
    "content": "{\"nodes\":[{\"id\":\"write-0\",\"type\":\"file\",\"file\":\"Draft.md\",\"x\":-600,\"y\":-110,\"width\":350,\"height\":220},{\"id\":\"write-1\",\"type\":\"file\",\"file\":\"Section.md\",\"x\":-280,\"y\":-110,\"width\":350,\"height\":220},{\"id\":\"write-2\",\"type\":\"file\",\"file\":\"Review.md\",\"x\":40,\"y\":-110,\"width\":350,\"height\":220}],\"edges\":[]}"
  },
  "steps": [
    {
      "filename": "Draft.md",
      "content": "---\nzettelFlowSettings:\n  root: true\n  label: Draft\n  phase: DEVELOP\n  actions:\n    - type: prompt\n      id: zf-write-draft-title\n      description: Working title\n      hasUI: true\n      key: title\n      zone: context\n      label: Working title\n      placeholder: What are you writing?...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-write-draft-thesis\n      description: Thesis\n      hasUI: true\n      key: thesis\n      zone: context\n      label: Thesis\n      placeholder: The one thing this piece argues...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-write-draft-audience\n      description: Audience\n      hasUI: true\n      key: audience\n      zone: frontmatter\n      label: Audience\n      placeholder: Who is this for?...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-write-draft-tag\n      hasUI: false\n      key: writing\n      zone: frontmatter\n      staticBehaviour: true\n      staticValue: draft\n  onCreation:\n    - type: find-related\n      id: zf-write-draft-related\n      hasUI: false\n      key: related\n      zone: frontmatter\n      limit: 10\n  targetFolder: Writing/Drafts\n  childrenHeader: ''\n  optional: false\n---\n\n# {{title}}\n\n**Thesis:** {{thesis}}\n\n## Outline\n\n1. \n\n## Source notes\n\n{{related}}\n"
    },
    {
      "filename": "Section.md",
      "content": "---\nzettelFlowSettings:\n  root: true\n  label: Section\n  phase: DEVELOP\n  actions:\n    - type: prompt\n      id: zf-write-sec-title\n      description: Section title\n      hasUI: true\n      key: title\n      zone: context\n      label: Section title\n      placeholder: Name this section...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-write-sec-point\n      description: The point\n      hasUI: true\n      key: point\n      zone: context\n      label: The point\n      placeholder: The single idea this section makes...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-write-sec-draft\n      description: Part of draft\n      hasUI: true\n      key: draft\n      zone: frontmatter\n      label: Part of draft\n      placeholder: '[[the draft this belongs to]]...'\n      staticBehaviour: false\n    - type: prompt\n      id: zf-write-sec-tag\n      hasUI: false\n      key: writing\n      zone: frontmatter\n      staticBehaviour: true\n      staticValue: section\n  onCreation:\n    - type: suggest-link\n      id: zf-write-sec-suggest\n      hasUI: false\n      key: suggestedLinks\n      zone: frontmatter\n      limit: 5\n  targetFolder: Writing/Sections\n  childrenHeader: ''\n  optional: false\n---\n\n# {{title}}\n\n{{point}}\n\n**Draft:** {{draft}}\n\n## Suggested connections\n\n{{suggestedLinks}}\n"
    },
    {
      "filename": "Review.md",
      "content": "---\nzettelFlowSettings:\n  root: true\n  label: Review\n  phase: REVIEW\n  actions:\n    - type: prompt\n      id: zf-write-rev-title\n      description: What are you reviewing?\n      hasUI: true\n      key: title\n      zone: context\n      label: What are you reviewing?\n      placeholder: The draft or section under review...\n      staticBehaviour: false\n    - type: prompt\n      id: zf-write-rev-focus\n      description: Review focus\n      hasUI: true\n      key: focus\n      zone: context\n      label: Review focus\n      placeholder: Clarity, evidence, structure...?\n      staticBehaviour: false\n    - type: prompt\n      id: zf-write-rev-tag\n      hasUI: false\n      key: writing\n      zone: frontmatter\n      staticBehaviour: true\n      staticValue: review\n  onCreation:\n    - type: find-contradiction\n      id: zf-write-rev-contradiction\n      hasUI: false\n      key: contradictions\n      zone: frontmatter\n  targetFolder: Writing/Reviews\n  childrenHeader: ''\n  optional: false\n---\n\n# Review — {{title}}\n\n**Focus:** {{focus}}\n\n## Contradictions to resolve\n\n{{contradictions}}\n\n## Notes\n\n"
    }
  ]
}
