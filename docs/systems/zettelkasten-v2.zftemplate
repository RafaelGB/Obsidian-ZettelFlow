{
  "zfVersion": "1.0",
  "name": "Zettelkasten v2",
  "description": "The classic slip-box, upgraded. Three independent note types on one canvas — fleeting, literature and permanent — each its own entry point. The permanent note carries the on-creation pattern: it is ranked against your graph (find related · find contradictions · suggest links) and scored for maturity the moment it is created. Repositions the original Zettelkasten inbox example. Offline, no AI.",
  "author": "ZettelFlow",
  "difficulty": "medium",
  "canvas": {
    "filename": "Zettelkasten v2.canvas",
    "content": "{\"nodes\":[{\"id\":\"zk-fleet\",\"type\":\"file\",\"file\":\"Fleeting note.md\",\"x\":-720,\"y\":-110,\"width\":350,\"height\":220},{\"id\":\"zk-lit\",\"type\":\"file\",\"file\":\"Literature note.md\",\"x\":-180,\"y\":-110,\"width\":350,\"height\":220},{\"id\":\"zk-perm\",\"type\":\"file\",\"file\":\"Permanent note.md\",\"x\":360,\"y\":-110,\"width\":350,\"height\":220}],\"edges\":[]}"
  },
  "steps": [
    {
      "filename": "Fleeting note.md",
      "content": "---\nzettelFlowSettings:\n  root: true\n  label: Fleeting note\n  phase: CAPTURE\n  actions:\n  - type: prompt\n    id: zf-zk-fleet-title\n    description: Capture your thought\n    hasUI: true\n    key: title\n    zone: context\n    label: Capture your thought\n    placeholder: What is on your mind?...\n    staticBehaviour: false\n  - type: prompt\n    id: zf-zk-fleet-state\n    hasUI: false\n    key: state\n    zone: frontmatter\n    staticBehaviour: true\n    staticValue: fleeting\n  targetFolder: Zettelkasten/Fleeting\n  childrenHeader: ''\n  optional: false\n  onCreation:\n  - type: find-related\n    id: zf-zettelkasten-v2-0-find-related0\n    hasUI: false\n    key: related\n    zone: frontmatter\n    limit: 10\n  - type: calculate-maturity\n    id: zf-zettelkasten-v2-0-calculate-maturity1\n    hasUI: false\n    key: maturity\n    zone: frontmatter\n  - type: detect-orphan\n    id: zf-zettelkasten-v2-0-detect-orphan2\n    hasUI: false\n    key: orphan\n    zone: frontmatter\n  - type: suggest-next-move\n    id: zf-zettelkasten-v2-0-suggest-next-move3\n    hasUI: false\n    key: nextMoves\n    zone: frontmatter\n  - type: suggest-link\n    id: zf-zettelkasten-v2-0-suggest-link\n    hasUI: false\n    key: suggestedLinks\n    zone: frontmatter\n    limit: 10\n---\n\n# {{title}}\n"
    },
    {
      "filename": "Literature note.md",
      "content": "---\nzettelFlowSettings:\n  root: true\n  label: Literature note\n  phase: PROCESS\n  actions:\n  - type: prompt\n    id: zf-zk-lit-title\n    description: Title\n    hasUI: true\n    key: title\n    zone: context\n    label: Title\n    placeholder: Give this literature note a name...\n    staticBehaviour: false\n  - type: prompt\n    id: zf-zk-lit-source\n    description: Source\n    hasUI: true\n    key: source\n    zone: frontmatter\n    label: Source\n    placeholder: Book, article, video...\n    staticBehaviour: false\n  - type: prompt\n    id: zf-zk-lit-summary\n    description: Your summary\n    hasUI: true\n    key: summary\n    zone: context\n    label: Your summary\n    placeholder: Summarise it in your own words...\n    staticBehaviour: false\n  - type: prompt\n    id: zf-zk-lit-state\n    hasUI: false\n    key: state\n    zone: frontmatter\n    staticBehaviour: true\n    staticValue: literature\n  onCreation:\n  - type: extract-claims\n    id: zf-zk-lit-extract\n    hasUI: false\n    key: claims\n    zone: frontmatter\n  - type: find-related\n    id: zf-zk-lit-related\n    hasUI: false\n    key: related\n    zone: frontmatter\n    limit: 10\n  - type: calculate-maturity\n    id: zf-zettelkasten-v2-1-calculate-maturity0\n    hasUI: false\n    key: maturity\n    zone: frontmatter\n  - type: detect-orphan\n    id: zf-zettelkasten-v2-1-detect-orphan1\n    hasUI: false\n    key: orphan\n    zone: frontmatter\n  - type: suggest-next-move\n    id: zf-zettelkasten-v2-1-suggest-next-move2\n    hasUI: false\n    key: nextMoves\n    zone: frontmatter\n  - type: suggest-link\n    id: zf-zettelkasten-v2-1-suggest-link\n    hasUI: false\n    key: suggestedLinks\n    zone: frontmatter\n    limit: 10\n  targetFolder: Zettelkasten/Literature\n  childrenHeader: ''\n  optional: false\n---\n\n# {{title}}\n\n**Source:** {{source}}\n\n{{summary}}\n\n## Claims\n\n## Related\n\n{{related}}\n"
    },
    {
      "filename": "Permanent note.md",
      "content": "---\nzettelFlowSettings:\n  root: true\n  label: Permanent note\n  phase: DEVELOP\n  actions:\n  - type: prompt\n    id: zf-zk-perm-title\n    description: Title\n    hasUI: true\n    key: title\n    zone: context\n    label: Title\n    placeholder: Name the idea...\n    staticBehaviour: false\n  - type: prompt\n    id: zf-zk-perm-idea\n    description: The atomic idea\n    hasUI: true\n    key: idea\n    zone: context\n    label: The atomic idea\n    placeholder: State one idea, in your own words...\n    staticBehaviour: false\n  - type: prompt\n    id: zf-zk-perm-connect\n    description: How does this connect to what you already know?\n    hasUI: true\n    key: connect\n    zone: context\n    label: How does this connect to what you already know?\n    placeholder: Link it to existing notes...\n    staticBehaviour: false\n  - type: prompt\n    id: zf-zk-perm-state\n    hasUI: false\n    key: state\n    zone: frontmatter\n    staticBehaviour: true\n    staticValue: permanent\n  onCreation:\n  - type: find-related\n    id: zf-zk-perm-related\n    hasUI: false\n    key: related\n    zone: frontmatter\n    limit: 10\n  - type: find-contradiction\n    id: zf-zk-perm-contradiction\n    hasUI: false\n    key: contradictions\n    zone: frontmatter\n  - type: suggest-link\n    id: zf-zk-perm-suggest\n    hasUI: false\n    key: suggestedLinks\n    zone: frontmatter\n    limit: 5\n  - type: calculate-maturity\n    id: zf-zk-perm-maturity\n    hasUI: false\n    key: maturity\n    zone: frontmatter\n  - type: detect-orphan\n    id: zf-zettelkasten-v2-2-detect-orphan0\n    hasUI: false\n    key: orphan\n    zone: frontmatter\n  - type: suggest-next-move\n    id: zf-zettelkasten-v2-2-suggest-next-move1\n    hasUI: false\n    key: nextMoves\n    zone: frontmatter\n  targetFolder: Zettelkasten/Permanent\n  childrenHeader: ''\n  optional: false\n---\n\n# {{title}}\n\n{{idea}}\n\n## Connections\n\n{{connect}}\n\n## Related\n\n{{related}}\n\n## Suggested connections\n\n{{suggestedLinks}}\n\n## Contradictions\n\n{{contradictions}}\n"
    }
  ]
}