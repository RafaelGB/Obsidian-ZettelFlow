{
  "zfVersion": "1.0",
  "name": "Academic research",
  "description": "Academic research, drawn as a flow: one capture asks whether you're taking notes on a source or recording a finding, and branches to a literature note (author, venue, method, claims) or a finding (claim, evidence, tensions) — cross-checked and maturity-scored on creation. Offline, no AI.",
  "author": "ZettelFlow",
  "difficulty": "hard",
  "canvas": {
    "filename": "Academic research.canvas",
    "content": "{\"nodes\":[{\"id\":\"ar-capture\",\"type\":\"text\",\"x\":-560,\"y\":20,\"width\":340,\"height\":250,\"color\":\"1\",\"text\":\"Research capture\",\"zettelflowConfig\":\"{\\\"slug\\\":\\\"ar-capture\\\",\\\"root\\\":true,\\\"label\\\":\\\"Research capture\\\",\\\"phase\\\":\\\"CAPTURE\\\",\\\"color\\\":\\\"1\\\",\\\"targetFolder\\\":\\\"Research\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"ar-title\\\",\\\"description\\\":\\\"Title\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"title\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Title\\\",\\\"placeholder\\\":\\\"Name it...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"selector\\\",\\\"id\\\":\\\"ar-kind\\\",\\\"description\\\":\\\"What is this?\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"kind\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"What is this?\\\",\\\"staticBehaviour\\\":false,\\\"defaultOption\\\":\\\"literature\\\",\\\"options\\\":[[\\\"literature\\\",\\\"Notes on a source I read\\\"],[\\\"finding\\\",\\\"A finding or claim of my own\\\"]]},{\\\"type\\\":\\\"tags\\\",\\\"id\\\":\\\"ar-tags\\\",\\\"hasUI\\\":true,\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"zettel-id\\\",\\\"id\\\":\\\"ar-id\\\",\\\"hasUI\\\":false,\\\"strategy\\\":\\\"timestamp\\\",\\\"key\\\":\\\"id\\\",\\\"writeFrontmatter\\\":true,\\\"writeFilename\\\":false,\\\"timestampFormat\\\":\\\"YYYYMMDDHHmm\\\",\\\"relationship\\\":\\\"child\\\"}],\\\"exits\\\":{\\\"ar-e-lit\\\":{\\\"says\\\":\\\"From a source\\\",\\\"when\\\":\\\"frontmatter.kind === \\\\\\\"literature\\\\\\\"\\\",\\\"order\\\":1,\\\"default\\\":true},\\\"ar-e-find\\\":{\\\"says\\\":\\\"My own finding\\\",\\\"when\\\":\\\"frontmatter.kind === \\\\\\\"finding\\\\\\\"\\\",\\\"order\\\":2}},\\\"exitFor\\\":[\\\"ar-e-lit\\\",\\\"ar-e-find\\\"],\\\"body\\\":\\\"\\\"}\"},{\"id\":\"ar-literature\",\"type\":\"text\",\"x\":-20,\"y\":-300,\"width\":340,\"height\":250,\"color\":\"3\",\"text\":\"Literature note\",\"zettelflowConfig\":\"{\\\"slug\\\":\\\"ar-literature\\\",\\\"root\\\":false,\\\"label\\\":\\\"Literature note\\\",\\\"phase\\\":\\\"PROCESS\\\",\\\"color\\\":\\\"3\\\",\\\"targetFolder\\\":\\\"Research/Literature\\\",\\\"says\\\":\\\"From a source\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"ar-lit-author\\\",\\\"description\\\":\\\"Author\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"author\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Author\\\",\\\"placeholder\\\":\\\"Who?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"ar-lit-source\\\",\\\"description\\\":\\\"Source\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"source\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Source\\\",\\\"placeholder\\\":\\\"Book / paper / article...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"ar-lit-year\\\",\\\"description\\\":\\\"Year\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"year\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"Year\\\",\\\"placeholder\\\":\\\"2026\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"ar-lit-venue\\\",\\\"description\\\":\\\"Venue\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"venue\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Venue\\\",\\\"placeholder\\\":\\\"Journal / publisher...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"ar-lit-summary\\\",\\\"description\\\":\\\"In your own words\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"summary\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"In your own words\\\",\\\"placeholder\\\":\\\"The idea, without quoting...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"ar-lit-method\\\",\\\"description\\\":\\\"Method / evidence\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"method\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Method / evidence\\\",\\\"placeholder\\\":\\\"How do they support it?\\\",\\\"staticBehaviour\\\":false}],\\\"onCreation\\\":[{\\\"type\\\":\\\"find-related\\\",\\\"id\\\":\\\"ar-lit-rel\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"related\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"limit\\\":10},{\\\"type\\\":\\\"extract-claims\\\",\\\"id\\\":\\\"ar-lit-claims\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"claims\\\",\\\"zone\\\":\\\"frontmatter\\\"},{\\\"type\\\":\\\"calculate-maturity\\\",\\\"id\\\":\\\"ar-lit-mat\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"maturity\\\",\\\"zone\\\":\\\"frontmatter\\\"}],\\\"body\\\":\\\"# {{title}}\\\\n\\\\n> {{author}} ({{year}}), *{{source}}* — {{venue}}\\\\n\\\\n## Summary\\\\n\\\\n{{summary}}\\\\n\\\\n## Method / evidence\\\\n\\\\n{{method}}\\\\n\\\\n## Claims\\\\n\\\\n{{claims}}\\\\n\\\\n## Related\\\\n\\\\n{{related}}\\\\n\\\"}\"},{\"id\":\"ar-finding\",\"type\":\"text\",\"x\":-20,\"y\":0,\"width\":340,\"height\":250,\"color\":\"5\",\"text\":\"Finding\",\"zettelflowConfig\":\"{\\\"slug\\\":\\\"ar-finding\\\",\\\"root\\\":false,\\\"label\\\":\\\"Finding\\\",\\\"phase\\\":\\\"DEVELOP\\\",\\\"color\\\":\\\"5\\\",\\\"targetFolder\\\":\\\"Research/Findings\\\",\\\"says\\\":\\\"My own finding\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"ar-find-claim\\\",\\\"description\\\":\\\"The finding\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"claim\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"The finding\\\",\\\"placeholder\\\":\\\"One sentence.\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"ar-find-evidence\\\",\\\"description\\\":\\\"Evidence\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"evidence\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Evidence\\\",\\\"placeholder\\\":\\\"What supports it?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"ar-find-implication\\\",\\\"description\\\":\\\"Implication\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"implication\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Implication\\\",\\\"placeholder\\\":\\\"So what?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"selector\\\",\\\"id\\\":\\\"ar-find-conf\\\",\\\"description\\\":\\\"Confidence\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"confidence\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"Confidence\\\",\\\"staticBehaviour\\\":false,\\\"defaultOption\\\":\\\"working\\\",\\\"options\\\":[[\\\"tentative\\\",\\\"Tentative\\\"],[\\\"working\\\",\\\"Working\\\"],[\\\"strong\\\",\\\"Strong\\\"]]}],\\\"onCreation\\\":[{\\\"type\\\":\\\"find-related\\\",\\\"id\\\":\\\"ar-find-rel\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"related\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"limit\\\":10},{\\\"type\\\":\\\"calculate-maturity\\\",\\\"id\\\":\\\"ar-find-mat\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"maturity\\\",\\\"zone\\\":\\\"frontmatter\\\"},{\\\"type\\\":\\\"find-contradiction\\\",\\\"id\\\":\\\"ar-find-con\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"contradictions\\\",\\\"zone\\\":\\\"frontmatter\\\"},{\\\"type\\\":\\\"find-unanswered-question\\\",\\\"id\\\":\\\"ar-find-q\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"openQuestions\\\",\\\"zone\\\":\\\"frontmatter\\\"}],\\\"body\\\":\\\"# {{title}}\\\\n\\\\n**Finding.** {{claim}}\\\\n\\\\n**Evidence.** {{evidence}}\\\\n\\\\n**Implication.** {{implication}}\\\\n\\\\n## Tensions\\\\n\\\\n{{contradictions}}\\\\n\\\\n## Open questions\\\\n\\\\n{{openQuestions}}\\\\n\\\\n## Related\\\\n\\\\n{{related}}\\\\n\\\"}\"}],\"edges\":[{\"id\":\"ar-e-lit\",\"fromNode\":\"ar-capture\",\"toNode\":\"ar-literature\",\"fromSide\":\"right\",\"toSide\":\"left\",\"label\":\"From a source\"},{\"id\":\"ar-e-find\",\"fromNode\":\"ar-capture\",\"toNode\":\"ar-finding\",\"fromSide\":\"right\",\"toSide\":\"left\",\"label\":\"My own finding\"}]}"
  },
  "steps": []
}
