{
  "zfVersion": "1.0",
  "name": "Academic research",
  "description": "A literature-to-permanent research workflow with two entry points on one canvas. A literature note is, on creation, mined for claims, matched to candidate sources, cross-checked for contradictions and scored for maturity; a permanent note lands already related, link-suggested and scored. Offline, no AI.",
  "author": "ZettelFlow",
  "difficulty": "hard",
  "canvas": {
    "filename": "Academic research.canvas",
    "content": "{\"nodes\":[{\"id\":\"acad-lit\",\"type\":\"file\",\"file\":\"Literature note.md\",\"x\":-440,\"y\":-110,\"width\":350,\"height\":220},{\"id\":\"acad-perm\",\"type\":\"file\",\"file\":\"Permanent note.md\",\"x\":120,\"y\":-110,\"width\":350,\"height\":220}],\"edges\":[]}"
  },
  "steps": [
    {
      "filename": "Literature note.md",
      "content": "---\nzettelFlowSettings:\n  root: true\n  label: Literature note\n  phase: PROCESS\n  actions:\n  - type: prompt\n    id: zf-acad-title\n    description: Title\n    hasUI: true\n    key: title\n    zone: context\n    label: Title\n    placeholder: Name this literature note...\n    staticBehaviour: false\n  - type: prompt\n    id: zf-acad-source\n    description: Source\n    hasUI: true\n    key: source\n    zone: frontmatter\n    label: Source\n    placeholder: Book, article, paper, talk...\n    staticBehaviour: false\n  - type: prompt\n    id: zf-acad-author\n    description: Author\n    hasUI: true\n    key: author\n    zone: frontmatter\n    label: Author\n    placeholder: Who created it?...\n    staticBehaviour: false\n  - type: prompt\n    id: zf-acad-summary\n    description: Your summary\n    hasUI: true\n    key: summary\n    zone: context\n    label: Your summary\n    placeholder: Summarise it in your own words...\n    staticBehaviour: false\n  - type: prompt\n    id: zf-acad-state\n    hasUI: false\n    key: state\n    zone: frontmatter\n    staticBehaviour: true\n    staticValue: literature\n  onCreation:\n  - type: extract-claims\n    id: zf-acad-extract\n    hasUI: false\n    key: claims\n    zone: frontmatter\n  - type: find-sources\n    id: zf-acad-sources\n    hasUI: false\n    key: candidateSources\n    zone: frontmatter\n    limit: 5\n  - type: find-contradiction\n    id: zf-acad-contradiction\n    hasUI: false\n    key: contradictions\n    zone: frontmatter\n  - type: calculate-maturity\n    id: zf-acad-maturity\n    hasUI: false\n    key: maturity\n    zone: frontmatter\n  - type: find-related\n    id: zf-academic-research-0-find-related0\n    hasUI: false\n    key: related\n    zone: frontmatter\n    limit: 10\n  - type: detect-orphan\n    id: zf-academic-research-0-detect-orphan1\n    hasUI: false\n    key: orphan\n    zone: frontmatter\n  - type: suggest-next-move\n    id: zf-academic-research-0-suggest-next-move2\n    hasUI: false\n    key: nextMoves\n    zone: frontmatter\n  - type: find-unanswered-question\n    id: zf-academic-research-0-find-unanswered-question3\n    hasUI: false\n    key: unanswered-questions\n    zone: frontmatter\n  - type: suggest-link\n    id: zf-academic-research-0-suggest-link\n    hasUI: false\n    key: suggestedLinks\n    zone: frontmatter\n    limit: 10\n  targetFolder: Research/Literature\n  childrenHeader: ''\n  optional: false\n---\n\n# {{title}}\n\n**Source:** {{source}} — {{author}}\n\n{{summary}}\n\n## Claims\n\n## Candidate sources\n\n## Contradictions\n"
    },
    {
      "filename": "Permanent note.md",
      "content": "---\nzettelFlowSettings:\n  root: true\n  label: Permanent note\n  phase: DEVELOP\n  actions:\n  - type: prompt\n    id: zf-acad-perm-title\n    description: Title\n    hasUI: true\n    key: title\n    zone: context\n    label: Title\n    placeholder: Name the idea...\n    staticBehaviour: false\n  - type: prompt\n    id: zf-acad-perm-idea\n    description: The atomic idea\n    hasUI: true\n    key: idea\n    zone: context\n    label: The atomic idea\n    placeholder: State one idea, in your own words...\n    staticBehaviour: false\n  - type: prompt\n    id: zf-acad-perm-connect\n    description: How does this connect to what you already know?\n    hasUI: true\n    key: connect\n    zone: context\n    label: How does this connect to what you already know?\n    placeholder: Link it to existing notes...\n    staticBehaviour: false\n  - type: prompt\n    id: zf-acad-perm-state\n    hasUI: false\n    key: state\n    zone: frontmatter\n    staticBehaviour: true\n    staticValue: permanent\n  onCreation:\n  - type: find-related\n    id: zf-acad-perm-related\n    hasUI: false\n    key: related\n    zone: frontmatter\n    limit: 10\n  - type: suggest-link\n    id: zf-acad-perm-suggest\n    hasUI: false\n    key: suggestedLinks\n    zone: frontmatter\n    limit: 5\n  - type: calculate-maturity\n    id: zf-acad-perm-maturity\n    hasUI: false\n    key: maturity\n    zone: frontmatter\n  - type: detect-orphan\n    id: zf-academic-research-1-detect-orphan0\n    hasUI: false\n    key: orphan\n    zone: frontmatter\n  - type: suggest-next-move\n    id: zf-academic-research-1-suggest-next-move1\n    hasUI: false\n    key: nextMoves\n    zone: frontmatter\n  - type: extract-claims\n    id: zf-academic-research-1-extract-claims2\n    hasUI: false\n    key: claims\n    zone: frontmatter\n  - type: find-unanswered-question\n    id: zf-academic-research-1-find-unanswered-question3\n    hasUI: false\n    key: unanswered-questions\n    zone: frontmatter\n  - type: find-contradiction\n    id: zf-academic-research-1-find-contradiction\n    hasUI: false\n    key: contradictions\n    zone: frontmatter\n  targetFolder: Research/Permanent\n  childrenHeader: ''\n  optional: false\n---\n\n# {{title}}\n\n{{idea}}\n\n## Connections\n\n{{connect}}\n\n## Related\n\n{{related}}\n\n## Suggested connections\n\n{{suggestedLinks}}\n"
    }
  ]
}