{
  "zfVersion": "1.0",
  "name": "Concept note",
  "description": "An evergreen concept note as a single rich step: name it, define it, say why it matters and give an example, stamp a Zettel id, and on creation get it related, cross-checked, maturity-scored and questioned — all in one inline box. Offline, no AI.",
  "author": "ZettelFlow",
  "difficulty": "easy",
  "canvas": {
    "filename": "Concept note.canvas",
    "content": "{\"nodes\":[{\"id\":\"cn-root\",\"type\":\"text\",\"x\":-180,\"y\":-40,\"width\":340,\"height\":250,\"color\":\"5\",\"text\":\"Concept note\",\"zettelflowConfig\":\"{\\\"slug\\\":\\\"cn\\\",\\\"label\\\":\\\"Concept note\\\",\\\"phase\\\":\\\"DEVELOP\\\",\\\"color\\\":\\\"5\\\",\\\"targetFolder\\\":\\\"Concepts\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"cn-title\\\",\\\"description\\\":\\\"Concept\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"title\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Concept\\\",\\\"placeholder\\\":\\\"Name it in your own words...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"cn-def\\\",\\\"description\\\":\\\"Definition\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"definition\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Definition\\\",\\\"placeholder\\\":\\\"What is it, precisely?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"cn-why\\\",\\\"description\\\":\\\"Why it matters\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"why\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Why it matters\\\",\\\"placeholder\\\":\\\"Why keep it?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"cn-example\\\",\\\"description\\\":\\\"Example\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"example\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Example\\\",\\\"placeholder\\\":\\\"A concrete instance...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"tags\\\",\\\"id\\\":\\\"cn-tags\\\",\\\"hasUI\\\":true,\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"zettel-id\\\",\\\"id\\\":\\\"cn-id\\\",\\\"hasUI\\\":false,\\\"strategy\\\":\\\"timestamp\\\",\\\"key\\\":\\\"id\\\",\\\"writeFrontmatter\\\":true,\\\"writeFilename\\\":false,\\\"timestampFormat\\\":\\\"YYYYMMDDHHmm\\\",\\\"relationship\\\":\\\"child\\\"}],\\\"onCreation\\\":[{\\\"type\\\":\\\"find-related\\\",\\\"id\\\":\\\"cn-rel\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"related\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"limit\\\":10},{\\\"type\\\":\\\"calculate-maturity\\\",\\\"id\\\":\\\"cn-mat\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"maturity\\\",\\\"zone\\\":\\\"frontmatter\\\"},{\\\"type\\\":\\\"find-contradiction\\\",\\\"id\\\":\\\"cn-con\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"contradictions\\\",\\\"zone\\\":\\\"frontmatter\\\"},{\\\"type\\\":\\\"find-unanswered-question\\\",\\\"id\\\":\\\"cn-q\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"openQuestions\\\",\\\"zone\\\":\\\"frontmatter\\\"}],\\\"body\\\":\\\"# {{title}}\\\\n\\\\n{{definition}}\\\\n\\\\n**Why it matters.** {{why}}\\\\n\\\\n**Example.** {{example}}\\\\n\\\\n## Related\\\\n\\\\n{{related}}\\\\n\\\\n## Tensions\\\\n\\\\n{{contradictions}}\\\\n\\\\n## Open questions\\\\n\\\\n{{openQuestions}}\\\\n\\\"}\"}],\"edges\":[]}"
  },
  "steps": []
}
