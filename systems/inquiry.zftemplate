{
  "zfVersion": "1.0",
  "name": "Inquiry",
  "description": "An inquiry as one inline step: a question worth your attention, why it matters, what you already know, a provisional response you own, and a next step — related and probed for open questions on creation. Offline, no AI.",
  "author": "ZettelFlow",
  "difficulty": "easy",
  "canvas": {
    "filename": "Inquiry.canvas",
    "content": "{\"nodes\":[{\"id\":\"iq-root\",\"type\":\"text\",\"x\":-180,\"y\":-40,\"width\":340,\"height\":250,\"color\":\"1\",\"text\":\"Inquiry\",\"zettelflowConfig\":\"{\\\"slug\\\":\\\"iq\\\",\\\"label\\\":\\\"Inquiry\\\",\\\"phase\\\":\\\"CAPTURE\\\",\\\"color\\\":\\\"1\\\",\\\"targetFolder\\\":\\\"Inquiries\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"iq-question\\\",\\\"description\\\":\\\"The question\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"question\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"The question\\\",\\\"placeholder\\\":\\\"What do you want to understand?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"iq-why\\\",\\\"description\\\":\\\"Why it matters\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"why\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Why it matters\\\",\\\"placeholder\\\":\\\"Why pursue it?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"iq-known\\\",\\\"description\\\":\\\"What you know\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"known\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"What you know\\\",\\\"placeholder\\\":\\\"Where you're starting from...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"iq-response\\\",\\\"description\\\":\\\"Provisional response\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"response\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Provisional response\\\",\\\"placeholder\\\":\\\"Your best answer for now...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"iq-next\\\",\\\"description\\\":\\\"Next step\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"next\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Next step\\\",\\\"placeholder\\\":\\\"What would move it forward?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"tags\\\",\\\"id\\\":\\\"iq-tags\\\",\\\"hasUI\\\":true,\\\"staticBehaviour\\\":false}],\\\"onCreation\\\":[{\\\"type\\\":\\\"find-related\\\",\\\"id\\\":\\\"iq-rel\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"related\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"limit\\\":10},{\\\"type\\\":\\\"find-unanswered-question\\\",\\\"id\\\":\\\"iq-q\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"openQuestions\\\",\\\"zone\\\":\\\"frontmatter\\\"}],\\\"body\\\":\\\"# {{question}}\\\\n\\\\n**Why it matters.** {{why}}\\\\n\\\\n## What I know\\\\n\\\\n{{known}}\\\\n\\\\n## Provisional response\\\\n\\\\n{{response}}\\\\n\\\\n**Next.** {{next}}\\\\n\\\\n## Open questions\\\\n\\\\n{{openQuestions}}\\\\n\\\\n## Related\\\\n\\\\n{{related}}\\\\n\\\"}\"}],\"edges\":[]}"
  },
