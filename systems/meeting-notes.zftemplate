{
  "zfVersion": "1.0",
  "name": "Meeting notes",
  "description": "Meeting notes as one inline step: title, date, attendees, agenda, the notes themselves, decisions and action items — related to the rest of your vault on creation. Offline, no AI.",
  "author": "ZettelFlow",
  "difficulty": "easy",
  "canvas": {
    "filename": "Meeting notes.canvas",
    "content": "{\"nodes\":[{\"id\":\"mt-root\",\"type\":\"text\",\"x\":-180,\"y\":-40,\"width\":340,\"height\":250,\"color\":\"1\",\"text\":\"Meeting notes\",\"zettelflowConfig\":\"{\\\"slug\\\":\\\"mt\\\",\\\"label\\\":\\\"Meeting notes\\\",\\\"phase\\\":\\\"CAPTURE\\\",\\\"color\\\":\\\"1\\\",\\\"targetFolder\\\":\\\"Meetings\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"mt-title\\\",\\\"description\\\":\\\"Title\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"title\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Title\\\",\\\"placeholder\\\":\\\"What meeting?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"calendar\\\",\\\"id\\\":\\\"mt-date\\\",\\\"description\\\":\\\"Date\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"date\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"Date\\\",\\\"staticBehaviour\\\":false,\\\"enableTime\\\":false,\\\"format\\\":\\\"YYYY-MM-DD\\\"},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"mt-attendees\\\",\\\"description\\\":\\\"Attendees\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"attendees\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Attendees\\\",\\\"placeholder\\\":\\\"Who was there?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"mt-agenda\\\",\\\"description\\\":\\\"Agenda\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"agenda\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Agenda\\\",\\\"placeholder\\\":\\\"What was it about?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"mt-notes\\\",\\\"description\\\":\\\"Notes\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"notes\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Notes\\\",\\\"placeholder\\\":\\\"What was said...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"mt-decisions\\\",\\\"description\\\":\\\"Decisions\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"decisions\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Decisions\\\",\\\"placeholder\\\":\\\"What was decided...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"mt-actions\\\",\\\"description\\\":\\\"Action items\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"actions\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Action items\\\",\\\"placeholder\\\":\\\"- [ ] who / what / when...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"tags\\\",\\\"id\\\":\\\"mt-tags\\\",\\\"hasUI\\\":true,\\\"staticBehaviour\\\":false}],\\\"onCreation\\\":[{\\\"type\\\":\\\"find-related\\\",\\\"id\\\":\\\"mt-rel\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"related\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"limit\\\":10}],\\\"body\\\":\\\"# {{title}}\\\\n\\\\n**Date.** {{date}} · **Attendees.** {{attendees}}\\\\n\\\\n## Agenda\\\\n\\\\n{{agenda}}\\\\n\\\\n## Notes\\\\n\\\\n{{notes}}\\\\n\\\\n## Decisions\\\\n\\\\n{{decisions}}\\\\n\\\\n## Action items\\\\n\\\\n{{actions}}\\\\n\\\\n## Related\\\\n\\\\n{{related}}\\\\n\\\"}\"}],\"edges\":[]}"
  },
  "steps": []
}
