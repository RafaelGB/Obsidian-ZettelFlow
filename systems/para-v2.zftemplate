{
  "zfVersion": "1.0",
  "name": "PARA v2",
  "description": "PARA, drawn as a flow: one classify step decides where an item belongs and branches to a Project, Area, Resource or Archive note — each a phased step with its own prompts, dates and a scaffolded body, filed in its PARA folder and connected on creation. Offline, no AI.",
  "author": "ZettelFlow",
  "difficulty": "hard",
  "canvas": {
    "filename": "PARA v2.canvas",
    "content": "{\"nodes\":[{\"id\":\"para-classify\",\"type\":\"text\",\"x\":-580,\"y\":40,\"width\":340,\"height\":240,\"color\":\"2\",\"text\":\"Classify\",\"zettelflowConfig\":\"{\\\"root\\\":true,\\\"label\\\":\\\"Classify\\\",\\\"phase\\\":\\\"CLASSIFY\\\",\\\"targetFolder\\\":\\\"PARA\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"para-title\\\",\\\"description\\\":\\\"Title\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"title\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Title\\\",\\\"placeholder\\\":\\\"Name it...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"para-what\\\",\\\"description\\\":\\\"What is it?\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"what\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"What is it?\\\",\\\"placeholder\\\":\\\"A line or two of context...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"selector\\\",\\\"id\\\":\\\"para-kind\\\",\\\"description\\\":\\\"Where does it belong?\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"para\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"Where does it belong?\\\",\\\"staticBehaviour\\\":false,\\\"defaultOption\\\":\\\"project\\\",\\\"options\\\":[[\\\"project\\\",\\\"Project — a goal with an end and next actions\\\"],[\\\"area\\\",\\\"Area — a standard to maintain over time\\\"],[\\\"resource\\\",\\\"Resource — reference material for later\\\"],[\\\"archive\\\",\\\"Archive — inactive, kept for the record\\\"]]},{\\\"type\\\":\\\"tags\\\",\\\"id\\\":\\\"para-tags\\\",\\\"hasUI\\\":true,\\\"staticBehaviour\\\":false}],\\\"exits\\\":{\\\"para-to-project\\\":{\\\"says\\\":\\\"Project\\\",\\\"when\\\":\\\"frontmatter.para === \\\\\\\"project\\\\\\\"\\\",\\\"order\\\":1,\\\"default\\\":true},\\\"para-to-area\\\":{\\\"says\\\":\\\"Area\\\",\\\"when\\\":\\\"frontmatter.para === \\\\\\\"area\\\\\\\"\\\",\\\"order\\\":2},\\\"para-to-resource\\\":{\\\"says\\\":\\\"Resource\\\",\\\"when\\\":\\\"frontmatter.para === \\\\\\\"resource\\\\\\\"\\\",\\\"order\\\":3},\\\"para-to-archive\\\":{\\\"says\\\":\\\"Archive\\\",\\\"when\\\":\\\"frontmatter.para === \\\\\\\"archive\\\\\\\"\\\",\\\"order\\\":4}},\\\"body\\\":\\\"\\\"}\"},{\"id\":\"para-project\",\"type\":\"text\",\"x\":-40,\"y\":-320,\"width\":340,\"height\":240,\"color\":\"5\",\"text\":\"Project\",\"zettelflowConfig\":\"{\\\"root\\\":false,\\\"label\\\":\\\"Project\\\",\\\"phase\\\":\\\"DEVELOP\\\",\\\"targetFolder\\\":\\\"PARA/1 Projects\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"para-proj-outcome\\\",\\\"description\\\":\\\"Outcome\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"outcome\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Outcome\\\",\\\"placeholder\\\":\\\"What does 'done' look like?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"para-proj-next\\\",\\\"description\\\":\\\"Next actions\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"nextActions\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Next actions\\\",\\\"placeholder\\\":\\\"The very next physical steps...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"calendar\\\",\\\"id\\\":\\\"para-proj-due\\\",\\\"description\\\":\\\"Target date\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"due\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"Target date\\\",\\\"staticBehaviour\\\":false,\\\"enableTime\\\":false,\\\"format\\\":\\\"YYYY-MM-DD\\\"}],\\\"onCreation\\\":[{\\\"type\\\":\\\"find-related\\\",\\\"id\\\":\\\"para-proj-related\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"related\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"limit\\\":10},{\\\"type\\\":\\\"calculate-maturity\\\",\\\"id\\\":\\\"para-proj-maturity\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"maturity\\\",\\\"zone\\\":\\\"frontmatter\\\"}],\\\"body\\\":\\\"# {{title}}\\\\n\\\\n{{what}}\\\\n\\\\n**Outcome.** {{outcome}}\\\\n\\\\n**Target.** {{due}}\\\\n\\\\n## Next actions\\\\n\\\\n{{nextActions}}\\\\n\\\\n## Related\\\\n\\\\n{{related}}\\\\n\\\"}\"},{\"id\":\"para-area\",\"type\":\"text\",\"x\":-40,\"y\":-40,\"width\":340,\"height\":240,\"color\":\"6\",\"text\":\"Area\",\"zettelflowConfig\":\"{\\\"root\\\":false,\\\"label\\\":\\\"Area\\\",\\\"phase\\\":\\\"CONSOLIDATE\\\",\\\"targetFolder\\\":\\\"PARA/2 Areas\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"para-area-standard\\\",\\\"description\\\":\\\"The standard\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"standard\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"The standard\\\",\\\"placeholder\\\":\\\"The level you hold this to...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"selector\\\",\\\"id\\\":\\\"para-area-cadence\\\",\\\"description\\\":\\\"Review cadence\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"cadence\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"Review cadence\\\",\\\"staticBehaviour\\\":false,\\\"defaultOption\\\":\\\"monthly\\\",\\\"options\\\":[[\\\"weekly\\\",\\\"Weekly\\\"],[\\\"monthly\\\",\\\"Monthly\\\"],[\\\"quarterly\\\",\\\"Quarterly\\\"]]}],\\\"onCreation\\\":[{\\\"type\\\":\\\"find-related\\\",\\\"id\\\":\\\"para-area-related\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"related\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"limit\\\":10}],\\\"body\\\":\\\"# {{title}}\\\\n\\\\n{{what}}\\\\n\\\\n**Standard.** {{standard}}\\\\n\\\\n**Review.** {{cadence}}\\\\n\\\\n## Related\\\\n\\\\n{{related}}\\\\n\\\"}\"},{\"id\":\"para-resource\",\"type\":\"text\",\"x\":-40,\"y\":240,\"width\":340,\"height\":240,\"color\":\"4\",\"text\":\"Resource\",\"zettelflowConfig\":\"{\\\"root\\\":false,\\\"label\\\":\\\"Resource\\\",\\\"phase\\\":\\\"CONNECT\\\",\\\"targetFolder\\\":\\\"PARA/3 Resources\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"para-res-source\\\",\\\"description\\\":\\\"Source\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"source\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Source\\\",\\\"placeholder\\\":\\\"Where is this from?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"para-res-link\\\",\\\"description\\\":\\\"Link\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"link\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Link\\\",\\\"placeholder\\\":\\\"URL or reference...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"para-res-topic\\\",\\\"description\\\":\\\"Topic\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"topic\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Topic\\\",\\\"placeholder\\\":\\\"What is it about?\\\",\\\"staticBehaviour\\\":false}],\\\"onCreation\\\":[{\\\"type\\\":\\\"find-related\\\",\\\"id\\\":\\\"para-res-related\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"related\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"limit\\\":10},{\\\"type\\\":\\\"extract-claims\\\",\\\"id\\\":\\\"para-res-claims\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"claims\\\",\\\"zone\\\":\\\"frontmatter\\\"}],\\\"body\\\":\\\"# {{title}}\\\\n\\\\n{{what}}\\\\n\\\\n**Source.** {{source}} — {{link}}\\\\n\\\\n**Topic.** {{topic}}\\\\n\\\\n## Claims\\\\n\\\\n{{claims}}\\\\n\\\\n## Related\\\\n\\\\n{{related}}\\\\n\\\"}\"},{\"id\":\"para-archive\",\"type\":\"text\",\"x\":-40,\"y\":520,\"width\":340,\"height\":240,\"color\":\"6\",\"text\":\"Archive\",\"zettelflowConfig\":\"{\\\"root\\\":false,\\\"label\\\":\\\"Archive\\\",\\\"phase\\\":\\\"REVIEW\\\",\\\"targetFolder\\\":\\\"PARA/4 Archive\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"para-arc-reason\\\",\\\"description\\\":\\\"Why archived?\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"reason\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Why archived?\\\",\\\"placeholder\\\":\\\"Done, dropped, or superseded?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"calendar\\\",\\\"id\\\":\\\"para-arc-on\\\",\\\"description\\\":\\\"Archived on\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"archivedOn\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"Archived on\\\",\\\"staticBehaviour\\\":false,\\\"enableTime\\\":false,\\\"format\\\":\\\"YYYY-MM-DD\\\"}],\\\"onCreation\\\":[{\\\"type\\\":\\\"detect-orphan\\\",\\\"id\\\":\\\"para-arc-orphan\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"orphan\\\",\\\"zone\\\":\\\"frontmatter\\\"}],\\\"body\\\":\\\"# {{title}}\\\\n\\\\n{{what}}\\\\n\\\\n**Archived.** {{archivedOn}} — {{reason}}\\\\n\\\"}\"}],\"edges\":[{\"id\":\"para-to-project\",\"fromNode\":\"para-classify\",\"toNode\":\"para-project\",\"fromSide\":\"right\",\"toSide\":\"left\",\"label\":\"Project\"},{\"id\":\"para-to-area\",\"fromNode\":\"para-classify\",\"toNode\":\"para-area\",\"fromSide\":\"right\",\"toSide\":\"left\",\"label\":\"Area\"},{\"id\":\"para-to-resource\",\"fromNode\":\"para-classify\",\"toNode\":\"para-resource\",\"fromSide\":\"right\",\"toSide\":\"left\",\"label\":\"Resource\"},{\"id\":\"para-to-archive\",\"fromNode\":\"para-classify\",\"toNode\":\"para-archive\",\"fromSide\":\"right\",\"toSide\":\"left\",\"label\":\"Archive\"}]}"
