{
  "zfVersion": "1.0",
  "name": "Reading",
  "description": "Reading, drawn as a flow: one capture asks whether you're logging a source or writing a note from your reading, and branches to a source card (type, status, link) or a reading note (the idea in your words, a quote, your take) — connected and claim-extracted on creation. Offline, no AI.",
  "author": "ZettelFlow",
  "difficulty": "medium",
  "canvas": {
    "filename": "Reading.canvas",
    "content": "{\"nodes\":[{\"id\":\"rd-capture\",\"type\":\"text\",\"x\":-560,\"y\":20,\"width\":340,\"height\":250,\"color\":\"1\",\"text\":\"Reading\",\"zettelflowConfig\":\"{\\\"slug\\\":\\\"rd-capture\\\",\\\"root\\\":true,\\\"label\\\":\\\"Reading\\\",\\\"phase\\\":\\\"CAPTURE\\\",\\\"color\\\":\\\"1\\\",\\\"targetFolder\\\":\\\"Reading\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"rd-title\\\",\\\"description\\\":\\\"Title\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"title\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Title\\\",\\\"placeholder\\\":\\\"The book / piece...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"selector\\\",\\\"id\\\":\\\"rd-kind\\\",\\\"description\\\":\\\"What are you doing?\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"kind\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"What are you doing?\\\",\\\"staticBehaviour\\\":false,\\\"defaultOption\\\":\\\"note\\\",\\\"options\\\":[[\\\"source\\\",\\\"Logging something to read\\\"],[\\\"note\\\",\\\"Writing a note from my reading\\\"]]},{\\\"type\\\":\\\"tags\\\",\\\"id\\\":\\\"rd-tags\\\",\\\"hasUI\\\":true,\\\"staticBehaviour\\\":false}],\\\"exits\\\":{\\\"rd-e-src\\\":{\\\"says\\\":\\\"Log a source\\\",\\\"when\\\":\\\"frontmatter.kind === \\\\\\\"source\\\\\\\"\\\",\\\"order\\\":1},\\\"rd-e-note\\\":{\\\"says\\\":\\\"A reading note\\\",\\\"when\\\":\\\"frontmatter.kind === \\\\\\\"note\\\\\\\"\\\",\\\"order\\\":2,\\\"default\\\":true}},\\\"exitFor\\\":[\\\"rd-e-src\\\",\\\"rd-e-note\\\"],\\\"body\\\":\\\"\\\"}\"},{\"id\":\"rd-source\",\"type\":\"text\",\"x\":-20,\"y\":-300,\"width\":340,\"height\":250,\"color\":\"4\",\"text\":\"Reading source\",\"zettelflowConfig\":\"{\\\"slug\\\":\\\"rd-source\\\",\\\"root\\\":false,\\\"label\\\":\\\"Reading source\\\",\\\"phase\\\":\\\"CONNECT\\\",\\\"color\\\":\\\"4\\\",\\\"targetFolder\\\":\\\"Reading/Sources\\\",\\\"says\\\":\\\"Log a source\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"rd-src-author\\\",\\\"description\\\":\\\"Author\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"author\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Author\\\",\\\"placeholder\\\":\\\"Who wrote it?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"rd-src-link\\\",\\\"description\\\":\\\"Link\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"link\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Link\\\",\\\"placeholder\\\":\\\"URL or reference...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"selector\\\",\\\"id\\\":\\\"rd-src-type\\\",\\\"description\\\":\\\"Type\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"type\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"Type\\\",\\\"staticBehaviour\\\":false,\\\"defaultOption\\\":\\\"article\\\",\\\"options\\\":[[\\\"book\\\",\\\"Book\\\"],[\\\"article\\\",\\\"Article\\\"],[\\\"paper\\\",\\\"Paper\\\"],[\\\"video\\\",\\\"Video\\\"]]},{\\\"type\\\":\\\"selector\\\",\\\"id\\\":\\\"rd-src-status\\\",\\\"description\\\":\\\"Status\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"status\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"Status\\\",\\\"staticBehaviour\\\":false,\\\"defaultOption\\\":\\\"to-read\\\",\\\"options\\\":[[\\\"to-read\\\",\\\"To read\\\"],[\\\"reading\\\",\\\"Reading\\\"],[\\\"read\\\",\\\"Read\\\"]]}],\\\"onCreation\\\":[{\\\"type\\\":\\\"find-related\\\",\\\"id\\\":\\\"rd-src-rel\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"related\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"limit\\\":10}],\\\"body\\\":\\\"# {{title}}\\\\n\\\\n**By.** {{author}} · **{{type}}** · {{status}}\\\\n\\\\n**Link.** {{link}}\\\\n\\\\n## Related\\\\n\\\\n{{related}}\\\\n\\\"}\"},{\"id\":\"rd-note\",\"type\":\"text\",\"x\":-20,\"y\":0,\"width\":340,\"height\":250,\"color\":\"3\",\"text\":\"Reading note\",\"zettelflowConfig\":\"{\\\"slug\\\":\\\"rd-note\\\",\\\"root\\\":false,\\\"label\\\":\\\"Reading note\\\",\\\"phase\\\":\\\"PROCESS\\\",\\\"color\\\":\\\"3\\\",\\\"targetFolder\\\":\\\"Reading/Notes\\\",\\\"says\\\":\\\"A reading note\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"rd-note-source\\\",\\\"description\\\":\\\"Source\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"source\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Source\\\",\\\"placeholder\\\":\\\"What are you reading?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"rd-note-page\\\",\\\"description\\\":\\\"Page / location\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"page\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"Page / location\\\",\\\"placeholder\\\":\\\"p. 42...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"rd-note-idea\\\",\\\"description\\\":\\\"The idea\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"idea\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"The idea\\\",\\\"placeholder\\\":\\\"In your own words...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"rd-note-quote\\\",\\\"description\\\":\\\"Quote (optional)\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"quote\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Quote (optional)\\\",\\\"placeholder\\\":\\\"A line worth keeping...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"rd-note-take\\\",\\\"description\\\":\\\"Your take\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"take\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Your take\\\",\\\"placeholder\\\":\\\"Why it matters to you...\\\",\\\"staticBehaviour\\\":false}],\\\"onCreation\\\":[{\\\"type\\\":\\\"find-related\\\",\\\"id\\\":\\\"rd-note-rel\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"related\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"limit\\\":10},{\\\"type\\\":\\\"extract-claims\\\",\\\"id\\\":\\\"rd-note-claims\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"claims\\\",\\\"zone\\\":\\\"frontmatter\\\"}],\\\"body\\\":\\\"# {{title}}\\\\n\\\\n> From *{{source}}* ({{page}})\\\\n\\\\n## The idea\\\\n\\\\n{{idea}}\\\\n\\\\n> {{quote}}\\\\n\\\\n## My take\\\\n\\\\n{{take}}\\\\n\\\\n## Related\\\\n\\\\n{{related}}\\\\n\\\"}\"}],\"edges\":[{\"id\":\"rd-e-src\",\"fromNode\":\"rd-capture\",\"toNode\":\"rd-source\",\"fromSide\":\"right\",\"toSide\":\"left\",\"label\":\"Log a source\"},{\"id\":\"rd-e-note\",\"fromNode\":\"rd-capture\",\"toNode\":\"rd-note\",\"fromSide\":\"right\",\"toSide\":\"left\",\"label\":\"A reading note\"}]}"
  },
