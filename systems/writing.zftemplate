    "filename": "Writing.canvas",
    "content": "{\"nodes\":[{\"id\":\"wr-capture\",\"type\":\"text\",\"x\":-560,\"y\":20,\"width\":340,\"height\":250,\"color\":\"1\",\"text\":\"Writing\",\"zettelflowConfig\":\"{\\\"slug\\\":\\\"wr-capture\\\",\\\"root\\\":true,\\\"label\\\":\\\"Writing\\\",\\\"phase\\\":\\\"CAPTURE\\\",\\\"color\\\":\\\"1\\\",\\\"targetFolder\\\":\\\"Writing\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"wr-title\\\",\\\"description\\\":\\\"Title\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"title\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Title\\\",\\\"placeholder\\\":\\\"Working title...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"selector\\\",\\\"id\\\":\\\"wr-stage\\\",\\\"description\\\":\\\"Where are you?\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"stage\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"Where are you?\\\",\\\"staticBehaviour\\\":false,\\\"defaultOption\\\":\\\"draft\\\",\\\"options\\\":[[\\\"draft\\\",\\\"Starting a draft\\\"],[\\\"section\\\",\\\"Drafting a section\\\"],[\\\"review\\\",\\\"Reviewing a piece\\\"]]},{\\\"type\\\":\\\"tags\\\",\\\"id\\\":\\\"wr-tags\\\",\\\"hasUI\\\":true,\\\"staticBehaviour\\\":false}],\\\"exits\\\":{\\\"wr-e-draft\\\":{\\\"says\\\":\\\"A draft\\\",\\\"when\\\":\\\"frontmatter.stage === \\\\\\\"draft\\\\\\\"\\\",\\\"order\\\":1,\\\"default\\\":true},\\\"wr-e-section\\\":{\\\"says\\\":\\\"A section\\\",\\\"when\\\":\\\"frontmatter.stage === \\\\\\\"section\\\\\\\"\\\",\\\"order\\\":2},\\\"wr-e-review\\\":{\\\"says\\\":\\\"A review\\\",\\\"when\\\":\\\"frontmatter.stage === \\\\\\\"review\\\\\\\"\\\",\\\"order\\\":3}},\\\"exitFor\\\":[\\\"wr-e-draft\\\",\\\"wr-e-section\\\",\\\"wr-e-review\\\"],\\\"body\\\":\\\"\\\"}\"},{\"id\":\"wr-draft\",\"type\":\"text\",\"x\":-20,\"y\":-300,\"width\":340,\"height\":250,\"color\":\"5\",\"text\":\"Draft\",\"zettelflowConfig\":\"{\\\"slug\\\":\\\"wr-draft\\\",\\\"root\\\":false,\\\"label\\\":\\\"Draft\\\",\\\"phase\\\":\\\"DEVELOP\\\",\\\"color\\\":\\\"5\\\",\\\"targetFolder\\\":\\\"Writing/Drafts\\\",\\\"says\\\":\\\"A draft\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"wr-draft-thesis\\\",\\\"description\\\":\\\"Thesis\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"thesis\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Thesis\\\",\\\"placeholder\\\":\\\"What are you claiming?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"wr-draft-audience\\\",\\\"description\\\":\\\"Audience\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"audience\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Audience\\\",\\\"placeholder\\\":\\\"Who is it for?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"wr-draft-outline\\\",\\\"description\\\":\\\"Outline\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"outline\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Outline\\\",\\\"placeholder\\\":\\\"The beats, in order...\\\",\\\"staticBehaviour\\\":false}],\\\"onCreation\\\":[{\\\"type\\\":\\\"find-related\\\",\\\"id\\\":\\\"wr-draft-rel\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"related\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"limit\\\":10},{\\\"type\\\":\\\"calculate-maturity\\\",\\\"id\\\":\\\"wr-draft-mat\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"maturity\\\",\\\"zone\\\":\\\"frontmatter\\\"}],\\\"body\\\":\\\"# {{title}}\\\\n\\\\n**Thesis.** {{thesis}}\\\\n\\\\n**Audience.** {{audience}}\\\\n\\\\n## Outline\\\\n\\\\n{{outline}}\\\\n\\\\n## Related\\\\n\\\\n{{related}}\\\\n\\\"}\"},{\"id\":\"wr-section\",\"type\":\"text\",\"x\":-20,\"y\":0,\"width\":340,\"height\":250,\"color\":\"3\",\"text\":\"Section\",\"zettelflowConfig\":\"{\\\"slug\\\":\\\"wr-section\\\",\\\"root\\\":false,\\\"label\\\":\\\"Section\\\",\\\"phase\\\":\\\"PROCESS\\\",\\\"color\\\":\\\"3\\\",\\\"targetFolder\\\":\\\"Writing/Sections\\\",\\\"says\\\":\\\"A section\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"wr-sec-heading\\\",\\\"description\\\":\\\"Heading\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"heading\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Heading\\\",\\\"placeholder\\\":\\\"The section title...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"wr-sec-points\\\",\\\"description\\\":\\\"Key points\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"points\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Key points\\\",\\\"placeholder\\\":\\\"What must this section land?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"wr-sec-draft\\\",\\\"description\\\":\\\"Draft\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"draft\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Draft\\\",\\\"placeholder\\\":\\\"Write it rough...\\\",\\\"staticBehaviour\\\":false}],\\\"onCreation\\\":[{\\\"type\\\":\\\"find-related\\\",\\\"id\\\":\\\"wr-section-rel\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"related\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"limit\\\":10}],\\\"body\\\":\\\"# {{title}} — {{heading}}\\\\n\\\\n**Points.** {{points}}\\\\n\\\\n{{draft}}\\\\n\\\\n## Related\\\\n\\\\n{{related}}\\\\n\\\"}\"},{\"id\":\"wr-review\",\"type\":\"text\",\"x\":-20,\"y\":300,\"width\":340,\"height\":250,\"color\":\"6\",\"text\":\"Review\",\"zettelflowConfig\":\"{\\\"slug\\\":\\\"wr-review\\\",\\\"root\\\":false,\\\"label\\\":\\\"Review\\\",\\\"phase\\\":\\\"REVIEW\\\",\\\"color\\\":\\\"6\\\",\\\"targetFolder\\\":\\\"Writing/Reviews\\\",\\\"says\\\":\\\"A review\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"wr-rev-works\\\",\\\"description\\\":\\\"What works\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"works\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"What works\\\",\\\"placeholder\\\":\\\"Keep this...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"wr-rev-fix\\\",\\\"description\\\":\\\"What to fix\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"fix\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"What to fix\\\",\\\"placeholder\\\":\\\"The weak spots...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"wr-rev-next\\\",\\\"description\\\":\\\"Next\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"next\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Next\\\",\\\"placeholder\\\":\\\"The next revision step...\\\",\\\"staticBehaviour\\\":false}],\\\"onCreation\\\":[{\\\"type\\\":\\\"find-related\\\",\\\"id\\\":\\\"wr-review-rel\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"related\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"limit\\\":10}],\\\"body\\\":\\\"# {{title}} — review\\\\n\\\\n## Works\\\\n\\\\n{{works}}\\\\n\\\\n## Fix\\\\n\\\\n{{fix}}\\\\n\\\\n## Next\\\\n\\\\n{{next}}\\\\n\\\\n## Related\\\\n\\\\n{{related}}\\\\n\\\"}\"}],\"edges\":[{\"id\":\"wr-e-draft\",\"fromNode\":\"wr-capture\",\"toNode\":\"wr-draft\",\"fromSide\":\"right\",\"toSide\":\"left\",\"label\":\"A draft\"},{\"id\":\"wr-e-section\",\"fromNode\":\"wr-capture\",\"toNode\":\"wr-section\",\"fromSide\":\"right\",\"toSide\":\"left\",\"label\":\"A section\"},{\"id\":\"wr-e-review\",\"fromNode\":\"wr-capture\",\"toNode\":\"wr-review\",\"fromSide\":\"right\",\"toSide\":\"left\",\"label\":\"A review\"}]}"
