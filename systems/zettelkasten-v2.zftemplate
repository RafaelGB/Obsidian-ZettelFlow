{
  "zfVersion": "1.0",
  "name": "Zettelkasten v2",
  "description": "The slip-box, drawn as a flow: one capture that asks what kind of note this is and branches to a fleeting, literature or permanent note — each a phased step with its own prompts and a scaffolded body, cross-checked and maturity-scored on creation. Offline, no AI.",
  "author": "ZettelFlow",
  "difficulty": "medium",
  "canvas": {
    "filename": "Zettelkasten v2.canvas",
    "content": "{\"nodes\":[{\"id\":\"zk-capture\",\"type\":\"text\",\"x\":-560,\"y\":-20,\"width\":340,\"height\":260,\"color\":\"1\",\"text\":\"Capture a Zettel\",\"zettelflowConfig\":\"{\\\"root\\\":true,\\\"label\\\":\\\"Capture a Zettel\\\",\\\"phase\\\":\\\"CAPTURE\\\",\\\"targetFolder\\\":\\\"Zettelkasten\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"zk-title\\\",\\\"description\\\":\\\"Title\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"title\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Title\\\",\\\"placeholder\\\":\\\"Name the note in your own words...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"zk-seed\\\",\\\"description\\\":\\\"The thought\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"seed\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"The thought\\\",\\\"placeholder\\\":\\\"What is the idea, in a sentence or two?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"selector\\\",\\\"id\\\":\\\"zk-origin\\\",\\\"description\\\":\\\"What kind of note is this?\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"origin\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"What kind of note is this?\\\",\\\"staticBehaviour\\\":false,\\\"defaultOption\\\":\\\"fleeting\\\",\\\"options\\\":[[\\\"fleeting\\\",\\\"A fleeting thought (capture now, decide later)\\\"],[\\\"source\\\",\\\"From a source I'm reading (literature)\\\"],[\\\"idea\\\",\\\"My own idea to keep (permanent)\\\"]]},{\\\"type\\\":\\\"tags\\\",\\\"id\\\":\\\"zk-tags\\\",\\\"hasUI\\\":true,\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"zettel-id\\\",\\\"id\\\":\\\"zk-id\\\",\\\"hasUI\\\":false,\\\"strategy\\\":\\\"timestamp\\\",\\\"key\\\":\\\"id\\\",\\\"writeFrontmatter\\\":true,\\\"writeFilename\\\":false,\\\"timestampFormat\\\":\\\"YYYYMMDDHHmm\\\",\\\"relationship\\\":\\\"child\\\"}],\\\"exits\\\":{\\\"zk-to-fleeting\\\":{\\\"says\\\":\\\"A fleeting thought\\\",\\\"when\\\":\\\"frontmatter.origin === \\\\\\\"fleeting\\\\\\\"\\\",\\\"order\\\":1,\\\"default\\\":true},\\\"zk-to-literature\\\":{\\\"says\\\":\\\"From a source\\\",\\\"when\\\":\\\"frontmatter.origin === \\\\\\\"source\\\\\\\"\\\",\\\"order\\\":2},\\\"zk-to-permanent\\\":{\\\"says\\\":\\\"My own idea\\\",\\\"when\\\":\\\"frontmatter.origin === \\\\\\\"idea\\\\\\\"\\\",\\\"order\\\":3}},\\\"body\\\":\\\"\\\"}\"},{\"id\":\"zk-fleeting\",\"type\":\"text\",\"x\":-20,\"y\":-300,\"width\":340,\"height\":260,\"color\":\"1\",\"text\":\"Fleeting note\",\"zettelflowConfig\":\"{\\\"root\\\":false,\\\"label\\\":\\\"Fleeting note\\\",\\\"phase\\\":\\\"CAPTURE\\\",\\\"targetFolder\\\":\\\"Zettelkasten/Fleeting\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"zk-fleeting-aside\\\",\\\"description\\\":\\\"Anything to add?\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"aside\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Anything to add?\\\",\\\"placeholder\\\":\\\"Optional — a link, a question, a next step...\\\",\\\"staticBehaviour\\\":false}],\\\"onCreation\\\":[{\\\"type\\\":\\\"detect-orphan\\\",\\\"id\\\":\\\"zk-fleeting-orphan\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"orphan\\\",\\\"zone\\\":\\\"frontmatter\\\"}],\\\"body\\\":\\\"# {{title}}\\\\n\\\\n{{seed}}\\\\n\\\\n{{aside}}\\\\n\\\\n> [!note] Fleeting\\\\n> Promote this to a **literature** or **permanent** note when it earns its place.\\\\n\\\"}\"},{\"id\":\"zk-literature\",\"type\":\"text\",\"x\":-20,\"y\":20,\"width\":340,\"height\":260,\"color\":\"3\",\"text\":\"Literature note\",\"zettelflowConfig\":\"{\\\"root\\\":false,\\\"label\\\":\\\"Literature note\\\",\\\"phase\\\":\\\"PROCESS\\\",\\\"targetFolder\\\":\\\"Zettelkasten/Literature\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"zk-lit-author\\\",\\\"description\\\":\\\"Author\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"author\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Author\\\",\\\"placeholder\\\":\\\"Who wrote it?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"zk-lit-source\\\",\\\"description\\\":\\\"Source title\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"source\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Source title\\\",\\\"placeholder\\\":\\\"The book, paper or article...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"zk-lit-link\\\",\\\"description\\\":\\\"Link or reference\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"link\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Link or reference\\\",\\\"placeholder\\\":\\\"URL, DOI or page reference...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"zk-lit-summary\\\",\\\"description\\\":\\\"In your own words\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"summary\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"In your own words\\\",\\\"placeholder\\\":\\\"Summarise the idea without quoting...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"zk-lit-take\\\",\\\"description\\\":\\\"Your take\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"take\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Your take\\\",\\\"placeholder\\\":\\\"Why does this matter to you? Do you agree?\\\",\\\"staticBehaviour\\\":false}],\\\"onCreation\\\":[{\\\"type\\\":\\\"find-related\\\",\\\"id\\\":\\\"zk-lit-related\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"related\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"limit\\\":10},{\\\"type\\\":\\\"extract-claims\\\",\\\"id\\\":\\\"zk-lit-claims\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"claims\\\",\\\"zone\\\":\\\"frontmatter\\\"},{\\\"type\\\":\\\"calculate-maturity\\\",\\\"id\\\":\\\"zk-lit-maturity\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"maturity\\\",\\\"zone\\\":\\\"frontmatter\\\"}],\\\"body\\\":\\\"# {{title}}\\\\n\\\\n> Source: {{author}}, *{{source}}* — {{link}}\\\\n\\\\n## In my own words\\\\n\\\\n{{summary}}\\\\n\\\\n## My take\\\\n\\\\n{{take}}\\\\n\\\\n## Claims\\\\n\\\\n{{claims}}\\\\n\\\\n## Related\\\\n\\\\n{{related}}\\\\n\\\"}\"},{\"id\":\"zk-permanent\",\"type\":\"text\",\"x\":-20,\"y\":340,\"width\":340,\"height\":260,\"color\":\"5\",\"text\":\"Permanent note\",\"zettelflowConfig\":\"{\\\"root\\\":false,\\\"label\\\":\\\"Permanent note\\\",\\\"phase\\\":\\\"DEVELOP\\\",\\\"targetFolder\\\":\\\"Zettelkasten/Permanent\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"zk-perm-claim\\\",\\\"description\\\":\\\"The claim\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"claim\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"The claim\\\",\\\"placeholder\\\":\\\"One sentence: the idea, stated as a claim.\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"zk-perm-why\\\",\\\"description\\\":\\\"Why it matters\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"why\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Why it matters\\\",\\\"placeholder\\\":\\\"What does this let you think or do?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"zk-perm-connections\\\",\\\"description\\\":\\\"Connections\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"connections\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Connections\\\",\\\"placeholder\\\":\\\"Which of your notes does this speak to?\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"selector\\\",\\\"id\\\":\\\"zk-perm-confidence\\\",\\\"description\\\":\\\"How settled is this?\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"confidence\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"How settled is this?\\\",\\\"staticBehaviour\\\":false,\\\"defaultOption\\\":\\\"working\\\",\\\"options\\\":[[\\\"tentative\\\",\\\"Tentative\\\"],[\\\"working\\\",\\\"Working\\\"],[\\\"confident\\\",\\\"Confident\\\"]]}],\\\"onCreation\\\":[{\\\"type\\\":\\\"find-related\\\",\\\"id\\\":\\\"zk-perm-related\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"related\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"limit\\\":10},{\\\"type\\\":\\\"calculate-maturity\\\",\\\"id\\\":\\\"zk-perm-maturity\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"maturity\\\",\\\"zone\\\":\\\"frontmatter\\\"},{\\\"type\\\":\\\"find-contradiction\\\",\\\"id\\\":\\\"zk-perm-contradiction\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"contradictions\\\",\\\"zone\\\":\\\"frontmatter\\\"},{\\\"type\\\":\\\"find-unanswered-question\\\",\\\"id\\\":\\\"zk-perm-questions\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"openQuestions\\\",\\\"zone\\\":\\\"frontmatter\\\"}],\\\"body\\\":\\\"# {{title}}\\\\n\\\\n**Claim.** {{claim}}\\\\n\\\\n**Why it matters.** {{why}}\\\\n\\\\n## Connections\\\\n\\\\n{{connections}}\\\\n\\\\n## Related\\\\n\\\\n{{related}}\\\\n\\\\n## Tensions\\\\n\\\\n{{contradictions}}\\\\n\\\\n## Open questions\\\\n\\\\n{{openQuestions}}\\\\n\\\"}\"}],\"edges\":[{\"id\":\"zk-to-fleeting\",\"fromNode\":\"zk-capture\",\"toNode\":\"zk-fleeting\",\"fromSide\":\"right\",\"toSide\":\"left\",\"label\":\"A fleeting thought\"},{\"id\":\"zk-to-literature\",\"fromNode\":\"zk-capture\",\"toNode\":\"zk-literature\",\"fromSide\":\"right\",\"toSide\":\"left\",\"label\":\"From a source\"},{\"id\":\"zk-to-permanent\",\"fromNode\":\"zk-capture\",\"toNode\":\"zk-permanent\",\"fromSide\":\"right\",\"toSide\":\"left\",\"label\":\"My own idea\"}]}"
  },
  "steps": []
}
