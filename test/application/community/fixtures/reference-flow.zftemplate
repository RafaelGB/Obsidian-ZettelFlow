  "canvas": {
    "filename": "Reference flow.canvas",
    "content": "{\"nodes\":[{\"id\":\"ref-capture\",\"type\":\"text\",\"x\":-400,\"y\":-120,\"width\":320,\"height\":200,\"color\":\"1\",\"text\":\"Capture\",\"zettelflowConfig\":\"{\\\"root\\\":true,\\\"label\\\":\\\"Capture\\\",\\\"phase\\\":\\\"CAPTURE\\\",\\\"targetFolder\\\":\\\"Reference\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"rc-title\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"title\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Title\\\",\\\"placeholder\\\":\\\"Name it...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"rc-note\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"note\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Note\\\",\\\"placeholder\\\":\\\"A line or two...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"selector\\\",\\\"id\\\":\\\"rc-kind\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"kind\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"label\\\":\\\"Kind\\\",\\\"staticBehaviour\\\":false,\\\"options\\\":[{\\\"label\\\":\\\"An A\\\",\\\"value\\\":\\\"a\\\"},{\\\"label\\\":\\\"A B\\\",\\\"value\\\":\\\"b\\\"}]}],\\\"exits\\\":{\\\"e-a\\\":{\\\"says\\\":\\\"It is an A\\\",\\\"when\\\":\\\"frontmatter.kind === \\\\\\\"a\\\\\\\"\\\",\\\"order\\\":1,\\\"default\\\":true},\\\"e-b\\\":{\\\"says\\\":\\\"It is a B\\\",\\\"when\\\":\\\"frontmatter.kind === \\\\\\\"b\\\\\\\"\\\",\\\"order\\\":2}},\\\"body\\\":\\\"# {{title}}\\\\n\\\\n{{note}}\\\\n\\\"}\"},{\"id\":\"ref-a\",\"type\":\"text\",\"x\":40,\"y\":-260,\"width\":320,\"height\":200,\"color\":\"3\",\"text\":\"Outcome A\",\"zettelflowConfig\":\"{\\\"root\\\":false,\\\"label\\\":\\\"Outcome A\\\",\\\"phase\\\":\\\"PROCESS\\\",\\\"targetFolder\\\":\\\"Reference/A\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"ra-detail\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"detail\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Detail\\\",\\\"placeholder\\\":\\\"...\\\",\\\"staticBehaviour\\\":false},{\\\"type\\\":\\\"tags\\\",\\\"id\\\":\\\"ra-tags\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"tags\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"staticBehaviour\\\":false}],\\\"onCreation\\\":[{\\\"type\\\":\\\"find-related\\\",\\\"id\\\":\\\"ra-rel\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"related\\\",\\\"zone\\\":\\\"frontmatter\\\",\\\"limit\\\":10},{\\\"type\\\":\\\"calculate-maturity\\\",\\\"id\\\":\\\"ra-mat\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"maturity\\\",\\\"zone\\\":\\\"frontmatter\\\"}],\\\"body\\\":\\\"# {{title}}\\\\n\\\\n{{detail}}\\\\n\\\\n## Related\\\\n\\\\n{{related}}\\\\n\\\"}\"},{\"id\":\"ref-b\",\"type\":\"text\",\"x\":40,\"y\":40,\"width\":320,\"height\":200,\"color\":\"5\",\"text\":\"Outcome B\",\"zettelflowConfig\":\"{\\\"root\\\":false,\\\"label\\\":\\\"Outcome B\\\",\\\"phase\\\":\\\"DEVELOP\\\",\\\"targetFolder\\\":\\\"Reference/B\\\",\\\"actions\\\":[{\\\"type\\\":\\\"prompt\\\",\\\"id\\\":\\\"rb-plan\\\",\\\"hasUI\\\":true,\\\"key\\\":\\\"plan\\\",\\\"zone\\\":\\\"context\\\",\\\"label\\\":\\\"Plan\\\",\\\"placeholder\\\":\\\"...\\\",\\\"staticBehaviour\\\":false}],\\\"onCreation\\\":[{\\\"type\\\":\\\"detect-orphan\\\",\\\"id\\\":\\\"rb-orph\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"orphan\\\",\\\"zone\\\":\\\"frontmatter\\\"},{\\\"type\\\":\\\"find-contradiction\\\",\\\"id\\\":\\\"rb-con\\\",\\\"hasUI\\\":false,\\\"key\\\":\\\"contradictions\\\",\\\"zone\\\":\\\"frontmatter\\\"}],\\\"body\\\":\\\"# {{title}}\\\\n\\\\n{{plan}}\\\\n\\\"}\"}],\"edges\":[{\"id\":\"e-a\",\"fromNode\":\"ref-capture\",\"toNode\":\"ref-a\",\"fromSide\":\"right\",\"toSide\":\"left\",\"label\":\"It is an A\"},{\"id\":\"e-b\",\"fromNode\":\"ref-capture\",\"toNode\":\"ref-b\",\"fromSide\":\"right\",\"toSide\":\"left\",\"label\":\"It is a B\"}]}"
  },
